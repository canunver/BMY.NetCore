<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Çalıştırılabilir uygulama (SGB.Net.exe). Yalnızca Program.cs ve ayar dosyasını içerir;
       sayfalar, uçlar ve bütün uygulama mantığı Istemci.dll içindedir. -->
  <PropertyGroup>
    <AssemblyName>SGB.Net</AssemblyName>
    <RootNamespace>SGBNet</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Istemci\Istemci.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Yayına girer: menü tanımları uygulama klasöründen okunur (MenuOkuyucu, MenuXML ayarı). -->
    <None Update="Menu\*.xml" CopyToPublishDirectory="PreserveNewest" />
    <!-- Yayına girmez: kuruma özel veriler (çerez şifreleme anahtarları, Komut Çalıştır'ın saklı sorguları). -->
    <Content Update="App_Data\**" CopyToPublishDirectory="Never" />
    <None Update="App_Data\**" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
