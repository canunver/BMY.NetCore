@page
@model PersonelDilModel
@{
    ViewData["Title"] = "Yabancı Dil";
    ViewData["GovdeSinif"] = "pb-alt";
}
@if (!Model.Yetkili)
{
    <div class="alert alert-warning" role="alert">Bu sayfayı kullanma yetkiniz yok.</div>
    return;
}

<div class="pb pb-egitim" id="pbDil" data-personel-kod="@Model.PersonelKod">
    <div class="pb-arac" role="toolbar" aria-label="Yabancı dil işlemleri">
        <button type="button" id="btnKaydet" class="btn btn-primary btn-sm">
            <span class="glyphicon glyphicon-floppy-disk" aria-hidden="true"></span> Kaydet
        </button>
        <button type="button" id="btnSil" class="btn btn-danger btn-sm">
            <span class="glyphicon glyphicon-trash" aria-hidden="true"></span> Sil
        </button>
        <button type="button" id="btnTemizle" class="btn btn-default btn-sm" title="Formu temizle">
            <span class="glyphicon glyphicon-file" aria-hidden="true"></span> Yeni Kayıt
        </button>
        <button type="button" id="btnYardim" class="btn btn-default btn-sm" aria-controls="pbYardim" aria-expanded="false" title="Açıklama">
            <span class="glyphicon glyphicon-info-sign" aria-hidden="true"></span><span class="sr-only">Açıklama</span>
        </button>
    </div>
    <p id="pbYardim" class="pb-yardim" hidden>
        Sertifika ile aldığınız yabancı dil bilgilerinizi veya KPDS, ÜDS gibi sınav bilgilerinizi ilgili alanlara girerek kayıt ediniz,
        sertifikanız olmadan da bildiğiniz dil varsa girebilirsiniz, kayıt ettikleriniz sağdaki listede gözükecektir. Kaydedip
        bitirdiğiniz bilgilerden sonra yine bu formu kullanarak başka (birden fazla bildiğiniz diller için) dil bilgisi kayıtlarınızı
        yapabilirsiniz. Tarihi tam olarak bilmiyorsanız 01.01.YIL olarak giriş yapınız.
    </p>

    <div class="pb-egitim-govde">
        <form id="frmDil" class="pb-egitim-form" novalidate autocomplete="off">
            <section class="pb-bolum renk-mavi">
                <h3>Yabancı Dil</h3>
                <div class="pb-govde pb-form">
                    <div class="form-group">
                        <label class="control-label" for="cmbDil">Yabancı Dil</label>
                        <div><select id="cmbDil" class="form-control"></select></div>
                    </div>
                    <div class="form-group">
                        <span class="control-label">Belge</span>
                        <div class="alt-alanlar">
                            <label><span class="alt-etiket">Türü</span><select id="cmbBelgeTuru" class="form-control"></select></label>
                            <label><span class="alt-etiket">No</span><input type="text" id="txtBelgeNo" class="form-control" /></label>
                            <label><span class="alt-etiket">Tarihi</span><input type="date" id="txtBelgeTarihi" class="form-control" /></label>
                        </div>
                    </div>
                    <div class="form-group">
                        <span class="control-label">Dönem</span>
                        <div class="alt-alanlar">
                            <label><span class="alt-etiket">Ay</span><select id="cmbDonemAy" class="form-control"></select></label>
                            <label><span class="alt-etiket">Yıl</span><input type="number" id="txtDonemYil" class="form-control sgb-yil" step="1" /></label>
                            <label><span class="alt-etiket">Tarihi</span><input type="date" id="txtTarih" class="form-control" /></label>
                        </div>
                    </div>
                    <div class="form-group">
                        <span class="control-label">Derece</span>
                        <div class="alt-alanlar">
                            <label>
                                <span class="alt-etiket">Düzey</span>
                                <select id="cmbDuzey" class="form-control">
                                    <option value=""></option>
                                    <option value="A+">A+</option>
                                    <option value="A">A</option>
                                    <option value="B">B</option>
                                    <option value="C">C</option>
                                    <option value="D">D</option>
                                </select>
                            </label>
                            <label><span class="alt-etiket">Puan</span><input type="text" id="txtPuan" class="form-control" inputmode="decimal" /></label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label" for="txtDilSeviyesi">Dil Seviyesi</label>
                        <div>
                            <input type="text" id="txtDilSeviyesi" class="form-control" list="lstDilSeviyesi" />
                            <datalist id="lstDilSeviyesi">
                                <option value="Alt"></option>
                                <option value="Çok İyi"></option>
                                <option value="İyi"></option>
                                <option value="Orta"></option>
                            </datalist>
                        </div>
                    </div>
                    <div class="form-group">
                        <span class="control-label"></span>
                        <div class="secenekler">
                            <label><input type="checkbox" id="chkBordroyaEsas" /> Bordroya esas yabancı dil bilgisi</label>
                            <label><input type="checkbox" id="chkKurumFaydalaniyor" /> Kurum Faydalanıyor</label>
                        </div>
                    </div>
                </div>
            </section>

            <section class="pb-bolum renk-mor">
                <h3>Belgeler</h3>
                <div class="pb-govde">
                    <div class="pb-belge-arac">
                        <button type="button" id="btnBelgeEkle" class="btn btn-default btn-sm">
                            <span class="glyphicon glyphicon-plus" aria-hidden="true"></span> Belge Ekle
                        </button>
                        <input type="file" id="fuBelge" hidden />
                    </div>
                    <div id="grdBelgeler" class="pb-belge-grid" aria-label="Belgeler"></div>
                </div>
            </section>
        </form>

        <section class="pb-bolum renk-gri pb-egitim-liste">
            <h3>Yabancı Dil Bilgileri</h3>
            <div class="pb-govde pb-doldur">
                <div id="grdListe" class="pb-grid" aria-label="Yabancı dil bilgileri"></div>
            </div>
        </section>
    </div>
</div>

@section Baslik {
    <link rel="stylesheet" href="~/css/personelalt.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/personel-egitim.css" asp-append-version="true" />
}
@section Betikler {
    <script src="~/lib/ag-grid/ag-grid-community.min.js"></script>
    <script src="~/js/personel-egitim-ortak.js" asp-append-version="true"></script>
    <script src="~/js/personel-dil.js" asp-append-version="true"></script>
}
