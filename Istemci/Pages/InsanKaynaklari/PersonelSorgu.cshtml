@page
@model PersonelSorguModel
@{
    ViewData["Title"] = "Personel Arama";
    ViewData["GovdeSinif"] = "pb-alt";
}
@if (!Model.Yetkili)
{
    <div class="alert alert-warning">Bu sayfayı kullanma yetkiniz yok.</div>
    return;
}

<div class="pb psr" id="psrSayfa" data-tip="@Model.Tip">
    <div class="psr-govde">
        <section class="pb-bolum renk-mavi psr-sol">
            <h3>Personel Arama</h3>
            <div class="pb-govde">
                <form id="frmSorgu" class="pb-form" novalidate autocomplete="off" style="--etiket-genislik: 60px">
                    <div class="form-group">
                        <label class="control-label" for="txtGenelSorgu">Arama</label>
                        <div><input type="text" id="txtGenelSorgu" class="form-control" /></div>
                    </div>
                    <div class="form-group">
                        <label class="control-label" for="cmbUnvan">Unvan</label>
                        <div><select id="cmbUnvan" class="form-control"></select></div>
                    </div>
                    <div class="form-group">
                        <span class="control-label">Birimi</span>
                        <div class="yan-yana">
                            <span id="lblBirim" class="psr-secili text-muted">Seçilmedi</span>
                            <button type="button" id="btnBirimTemizle" class="btn btn-default btn-xs" title="Birim seçimini kaldır">
                                <span class="glyphicon glyphicon-remove" aria-hidden="true"></span>
                            </button>
                        </div>
                    </div>
                    <div class="pb-arac">
                        <span class="bosluk"></span>
                        <button type="submit" id="btnListele" class="btn btn-primary btn-sm">
                            <span class="glyphicon glyphicon-search" aria-hidden="true"></span> Listele
                        </button>
                    </div>
                </form>
                <ul id="agcBirim" class="psr-agac" aria-label="Birimler"></ul>
            </div>
        </section>

        <section class="pb-bolum renk-yesil psr-sag">
            <h3>Personel Listesi</h3>
            <div class="pb-govde pb-doldur">
                <div id="grdListe" class="pb-grid" aria-label="Personel listesi"></div>
                <p class="pb-not">Seçmek için personelin satırına tıklayın.</p>
            </div>
        </section>
    </div>
</div>

@section Baslik {
    <link rel="stylesheet" href="~/css/personelalt.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/personel-kart.css" asp-append-version="true" />
}
@section Betikler {
    <script src="~/lib/ag-grid/ag-grid-community.min.js"></script>
    <script src="~/js/personel-sorgu.js" asp-append-version="true"></script>
}
