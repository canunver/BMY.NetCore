@page
@model PersonelCezaOdulModel
@{
    ViewData["Title"] = "Ceza/Ödül";
    ViewData["GovdeSinif"] = "pb-alt";
}
@if (!Model.Yetkili)
{
    <div class="alert alert-warning" role="alert">Bu sayfayı kullanma yetkiniz yok.</div>
    return;
}

<div class="pb pb-egitim" id="pbCezaOdul" data-personel-kod="@Model.PersonelKod">
    <div class="pb-arac" role="toolbar" aria-label="Ceza/ödül işlemleri">
        <button type="button" id="btnKaydet" class="btn btn-primary btn-sm">
            <span class="glyphicon glyphicon-floppy-disk" aria-hidden="true"></span> Kaydet
        </button>
        <button type="button" id="btnSil" class="btn btn-danger btn-sm">
            <span class="glyphicon glyphicon-trash" aria-hidden="true"></span> Sil
        </button>
        <button type="button" id="btnTemizle" class="btn btn-default btn-sm" title="Formu temizle">
            <span class="glyphicon glyphicon-file" aria-hidden="true"></span> Yeni Kayıt
        </button>
    </div>

    <div class="pb-egitim-govde">
        <form id="frmCezaOdul" class="pb-egitim-form" novalidate autocomplete="off">
            <section class="pb-bolum renk-mavi">
                <h3>Ceza/Ödül</h3>
                <div class="pb-govde pb-form">
                    <div class="form-group">
                        <label class="control-label" for="cmbTip">Ceza/Ödül Tipi</label>
                        <div><select id="cmbTip" class="form-control"></select></div>
                    </div>
                    <div class="form-group">
                        <label class="control-label" for="txtTarih">Tarih</label>
                        <div><input type="date" id="txtTarih" class="form-control dar" /></div>
                    </div>
                </div>
            </section>

            <section class="pb-bolum renk-yesil">
                <h3>Veren</h3>
                <div class="pb-govde pb-form">
                    <div class="form-group">
                        <label class="control-label" for="txtVerenKurum">Kurum</label>
                        <div><input type="text" id="txtVerenKurum" class="form-control" /></div>
                    </div>
                    <div class="form-group">
                        <label class="control-label" for="txtVerenAd">Ad</label>
                        <div><input type="text" id="txtVerenAd" class="form-control" /></div>
                    </div>
                    <div class="form-group">
                        <label class="control-label" for="txtVerenUnvan">Unvan</label>
                        <div><input type="text" id="txtVerenUnvan" class="form-control" /></div>
                    </div>
                </div>
            </section>

            <section class="pb-bolum renk-mavi">
                <h3>Ayrıntı</h3>
                <div class="pb-govde pb-form">
                    <div class="form-group">
                        <label class="control-label" for="txtAlanUnvan">Alan Unvan</label>
                        <div><input type="text" id="txtAlanUnvan" class="form-control" /></div>
                    </div>
                    <div class="form-group">
                        <label class="control-label" for="txtCinsi">Cinsi</label>
                        <div><input type="text" id="txtCinsi" class="form-control" /></div>
                    </div>
                    <div class="form-group">
                        <label class="control-label" for="txtSebebi">Sebebi</label>
                        <div><input type="text" id="txtSebebi" class="form-control" /></div>
                    </div>
                    <div class="form-group">
                        <label class="control-label" for="txtDayanak">Dayanak</label>
                        <div><input type="text" id="txtDayanak" class="form-control" /></div>
                    </div>
                </div>
            </section>

            <section class="pb-bolum renk-turuncu">
                <h3>Belge</h3>
                <div class="pb-govde pb-form">
                    <div class="form-group">
                        <label class="control-label" for="txtBelgeNo">No</label>
                        <div><input type="text" id="txtBelgeNo" class="form-control" /></div>
                    </div>
                    <div class="form-group">
                        <label class="control-label" for="txtBelgeTarihi">Tarih</label>
                        <div><input type="date" id="txtBelgeTarihi" class="form-control dar" /></div>
                    </div>
                    <div class="form-group">
                        <label class="control-label" for="txtBelgeCinsi">Cinsi</label>
                        <div><input type="text" id="txtBelgeCinsi" class="form-control" /></div>
                    </div>
                </div>
            </section>
        </form>

        <section class="pb-bolum renk-gri pb-egitim-liste">
            <h3>Ceza/Ödül Bilgileri</h3>
            <div class="pb-govde pb-doldur">
                <div id="grdListe" class="pb-grid" aria-label="Ceza/ödül bilgileri"></div>
            </div>
        </section>
    </div>
</div>

@section Baslik {
    <link rel="stylesheet" href="~/css/personelalt.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/personel-egitim.css" asp-append-version="true" />
}
@section Betikler {
    <script src="~/lib/ag-grid/ag-grid-community.min.js"></script>
    <script src="~/js/personel-egitim-ortak.js" asp-append-version="true"></script>
    <script src="~/js/personel-cezaodul.js" asp-append-version="true"></script>
}
