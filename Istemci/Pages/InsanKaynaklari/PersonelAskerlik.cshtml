@page
@model PersonelAskerlikModel
@{
    ViewData["Title"] = "Askerlik";
    ViewData["GovdeSinif"] = "pb-alt";
}
@if (!Model.Yetkili)
{
    <div class="alert alert-warning">Bu sayfayı kullanma yetkiniz yok.</div>
    return;
}

<div class="pb pas" id="pasSayfa" data-personel-kod="@Model.PersonelKod">
    <div class="pb-arac" role="toolbar">
        <button type="button" id="btnKaydet" class="btn btn-primary btn-sm">
            <span class="glyphicon glyphicon-floppy-disk" aria-hidden="true"></span> Kaydet
        </button>
    </div>

    <form id="frmAskerlik" novalidate autocomplete="off" class="pas-govde">
        <section class="pb-bolum renk-mavi">
            <h3>Askerlik Durumu</h3>
            <div class="pb-govde pb-form">
                <div class="form-group">
                    <label class="control-label" for="ddlAskerlikDurumu">Askerlik Durumu</label>
                    <div><select id="ddlAskerlikDurumu" class="form-control"></select></div>
                </div>
                <div class="form-group" data-grup="tecil">
                    <label class="control-label" for="txtTecilTarihi">Tecil Tarihi</label>
                    <div><input type="date" id="txtTecilTarihi" class="form-control dar" /></div>
                </div>
                <div class="form-group" data-grup="muaf">
                    <label class="control-label" for="txtMuafNedeni">Muaf Nedeni</label>
                    <div><input type="text" id="txtMuafNedeni" class="form-control" /></div>
                </div>
                <div class="form-group" data-grup="normal">
                    <span class="control-label"></span>
                    <div><label class="pas-kutu"><input type="checkbox" id="chkBorclanma" /> Borçlanma Var Mı?</label></div>
                </div>
            </div>
        </section>

        <section class="pb-bolum renk-yesil" data-grup="normal">
            <h3>Askerlik Bilgileri</h3>
            <div class="pb-govde pb-form iki-sutun">
                <div class="form-group">
                    <label class="control-label" for="txtDuhulTarihi">Duhul Tarihi</label>
                    <div><input type="date" id="txtDuhulTarihi" class="form-control dar" /></div>
                </div>
                <div class="form-group">
                    <label class="control-label" for="txtCuzdanNo">Askerlik Cüzdan No</label>
                    <div><input type="text" id="txtCuzdanNo" class="form-control" /></div>
                </div>
                <div class="form-group">
                    <label class="control-label" for="txtAskerlikSubesi">Askerlik Şubesi</label>
                    <div><input type="text" id="txtAskerlikSubesi" class="form-control" /></div>
                </div>
                <div class="form-group">
                    <label class="control-label" for="txtSayilmayanGunSayisi">Sayılmayan Gün Sayısı</label>
                    <div><input type="number" id="txtSayilmayanGunSayisi" class="form-control dar" min="0" step="1" /></div>
                </div>
            </div>
        </section>

        <section class="pb-bolum renk-mor" data-grup="normal">
            <h3>Terhis Bilgileri</h3>
            <div class="pb-govde pb-form iki-sutun">
                <div class="form-group">
                    <label class="control-label" for="txtTerhisTarihi">Terhis Tarihi</label>
                    <div><input type="date" id="txtTerhisTarihi" class="form-control dar" /></div>
                </div>
                <div class="form-group">
                    <label class="control-label" for="txtTerhisBelgeNo">Terhis Belge No</label>
                    <div><input type="text" id="txtTerhisBelgeNo" class="form-control" /></div>
                </div>
                <div class="form-group">
                    <label class="control-label" for="txtTerhisBelgeTarihi">Terhis Belge Tarihi</label>
                    <div><input type="date" id="txtTerhisBelgeTarihi" class="form-control dar" /></div>
                </div>
            </div>
        </section>

        <section class="pb-bolum renk-turuncu" data-grup="normal">
            <h3>Rütbe ve Nasp Bilgileri</h3>
            <div class="pb-govde pb-form iki-sutun">
                <div class="form-group">
                    <label class="control-label" for="ddlRutbe">Rütbesi</label>
                    <div><select id="ddlRutbe" class="form-control"></select></div>
                </div>
                <div class="form-group">
                    <label class="control-label" for="ddlSinif">Sınıfı</label>
                    <div><select id="ddlSinif" class="form-control"></select></div>
                </div>
                <div class="form-group">
                    <label class="control-label" for="txtAstegmenNaspTarihi">Asteğmen Nasp Tarihi</label>
                    <div><input type="date" id="txtAstegmenNaspTarihi" class="form-control dar" /></div>
                </div>
                <div class="form-group">
                    <label class="control-label" for="txtTegmenNaspTarihi">Teğmen Nasp Tarihi</label>
                    <div><input type="date" id="txtTegmenNaspTarihi" class="form-control dar" /></div>
                </div>
            </div>
        </section>

        <section class="pb-bolum renk-gri" data-grup="normal">
            <h3>Er - Yedek Subay Bilgileri</h3>
            <div class="pb-govde pb-form iki-sutun" style="--etiket-genislik: 230px">
                <div class="form-group">
                    <label class="control-label" for="txtYedekSubayOkuluGirisTarihi">Yedek Subay Okulu Giriş Tarihi</label>
                    <div><input type="date" id="txtYedekSubayOkuluGirisTarihi" class="form-control dar" /></div>
                </div>
                <div class="form-group">
                    <label class="control-label" for="txtSinifDonemSicilNo">Sınıf Dönem Sicil No</label>
                    <div><input type="text" id="txtSinifDonemSicilNo" class="form-control" /></div>
                </div>
                <div class="form-group">
                    <label class="control-label" for="txtErYedekSubayGorevYeri">Er Yedek Subay Görev Yeri</label>
                    <div><input type="text" id="txtErYedekSubayGorevYeri" class="form-control" /></div>
                </div>
                <div class="form-group">
                    <label class="control-label" for="txtErYedekSubayGecisTarihi">Erlikten Yedek Subaylığa Geçiş Tarihi</label>
                    <div><input type="date" id="txtErYedekSubayGecisTarihi" class="form-control dar" /></div>
                </div>
                <div class="form-group">
                    <label class="control-label" for="txtErYedekSubayKitaBaslamaTarihi">Kıta Hizmeti Başlama Tarihi</label>
                    <div><input type="date" id="txtErYedekSubayKitaBaslamaTarihi" class="form-control dar" /></div>
                </div>
                <div class="form-group">
                    <label class="control-label" for="txtErYedekSubayKitaBitisTarihi">Kıta Hizmeti Bitiş Tarihi</label>
                    <div><input type="date" id="txtErYedekSubayKitaBitisTarihi" class="form-control dar" /></div>
                </div>
            </div>
        </section>

        <section class="pb-bolum renk-mavi" data-grup="diger">
            <h3>Diğer Bilgiler</h3>
            <div class="pb-govde pb-form">
                <div class="form-group" data-grup="normal">
                    <label class="control-label" for="txtIbrazIntikalTarihi">İbraz İntikal Tarihi</label>
                    <div><input type="date" id="txtIbrazIntikalTarihi" class="form-control dar" /></div>
                </div>
                <div class="form-group" data-grup="aciklama">
                    <label class="control-label" for="txtAciklama">Açıklama</label>
                    <div><textarea id="txtAciklama" class="form-control" rows="2"></textarea></div>
                </div>
            </div>
        </section>
    </form>

    <section class="pb-bolum renk-yesil">
        <h3>
            <span>Belgeler</span>
            <span class="pas-bosluk"></span>
            <label class="btn btn-default btn-xs pas-dosya" title="Belge ekle (önce askerlik bilgileri kaydedilir)">
                <span class="glyphicon glyphicon-paperclip" aria-hidden="true"></span> Belge Ekle
                <input type="file" id="fileBelge" hidden />
            </label>
        </h3>
        <div class="pb-govde">
            <div id="grdBelgeler" class="pb-grid pas-belge-grid" aria-label="Belgeler"></div>
        </div>
    </section>
</div>

<dialog id="dlgOnay" class="pas-onay">
    <form method="dialog">
        <p id="dlgOnayMetin"></p>
        <div class="pas-onay-dugmeler">
            <button value="hayir" class="btn btn-default btn-sm">Vazgeç</button>
            <button value="evet" class="btn btn-primary btn-sm">Evet</button>
        </div>
    </form>
</dialog>

@section Baslik {
    <link rel="stylesheet" href="~/css/personelalt.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/personel-askerlik.css" asp-append-version="true" />
}
@section Betikler {
    <script src="~/lib/ag-grid/ag-grid-community.min.js"></script>
    <script src="~/js/personel-askerlik.js" asp-append-version="true"></script>
}
