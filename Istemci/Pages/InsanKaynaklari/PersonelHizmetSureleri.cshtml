@page
@model PersonelHizmetSureleriModel
@{
    ViewData["Title"] = "Hizmet Süreleri";
    ViewData["GovdeSinif"] = "pb-alt";
}
@if (!Model.Yetkili)
{
    <div class="alert alert-warning" role="alert">Bu sayfayı kullanma yetkiniz yok.</div>
    return;
}

<div class="pb pb-hizmetsureleri" id="pbHizmetSureleri" data-personel-kod="@Model.PersonelKod">
    <section class="pb-bolum">
        <h3>Hizmet Süreleri</h3>
        <div class="pb-govde pb-form pbk-etiket-cok-genis">
            <div class="form-group">
                <label class="control-label" for="txtToplamHizmet">Toplam Hizmet</label>
                <div><input type="text" id="txtToplamHizmet" class="form-control pbk-salt pbk-orta-alan" readonly /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtKAH">Kıdem Aylığı Hizmeti</label>
                <div><input type="text" id="txtKAH" class="form-control pbk-salt pbk-orta-alan" readonly /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtKHA">Kazanılmış Hak Aylığı Süresi</label>
                <div><input type="text" id="txtKHA" class="form-control pbk-salt pbk-orta-alan" readonly /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtEKEA">Emekli Keseneği Esas Aylığı Süresi</label>
                <div><input type="text" id="txtEKEA" class="form-control pbk-salt pbk-orta-alan" readonly /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtKurum">Kurumda Geçen Süre</label>
                <div><input type="text" id="txtKurum" class="form-control pbk-salt pbk-orta-alan" readonly /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtIzin">İzin Hesabı Süresi</label>
                <div><input type="text" id="txtIzin" class="form-control pbk-salt pbk-orta-alan" readonly /></div>
            </div>
        </div>
    </section>
</div>

@section Baslik {
    <link rel="stylesheet" href="~/css/personelalt.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/personel-kadro.css" asp-append-version="true" />
}
@section Betikler {
    <script src="~/js/personel-hizmetsureleri.js" asp-append-version="true"></script>
}
