@page
@model PersonelHizmetAyariModel
@{
    ViewData["Title"] = "Hizmet Ayarları";
    ViewData["GovdeSinif"] = "pb-alt";
}
@if (!Model.Yetkili)
{
    <div class="alert alert-warning" role="alert">Bu sayfayı kullanma yetkiniz yok.</div>
    return;
}

<div class="pb pb-hizmetayari" id="pbHizmetAyari" data-personel-kod="@Model.PersonelKod">
    <div class="pb-arac" role="toolbar">
        <button type="button" id="btnKaydet" class="btn btn-primary btn-sm"><span class="glyphicon glyphicon-floppy-disk" aria-hidden="true"></span> Kaydet</button>
    </div>

    <section class="pb-bolum">
        <h3>Kazanılmış Hak Aylığı (KHA)</h3>
        <div class="pb-govde pb-form pbk-etiket-genis">
            <div class="form-group">
                <label class="control-label" for="ddlKTAyi">KHA Terfi Ayı</label>
                <div><select id="ddlKTAyi" class="form-control pbk-orta-alan"></select></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtKAcilisTarihi">KHA Terfi Açılış Tarihi</label>
                <div><input type="date" id="txtKAcilisTarihi" class="form-control pbk-orta-alan" /></div>
            </div>
        </div>
    </section>

    <section class="pb-bolum renk-yesil">
        <h3>Emekli Keseneğine Esas Aylık (EKEA)</h3>
        <div class="pb-govde pb-form pbk-etiket-genis">
            <div class="form-group">
                <label class="control-label" for="ddlETAyi">EKEA Terfi Ayı</label>
                <div><select id="ddlETAyi" class="form-control pbk-orta-alan"></select></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtEAcilisTarihi">EKEA Terfi Açılış Tarihi</label>
                <div><input type="date" id="txtEAcilisTarihi" class="form-control pbk-orta-alan" /></div>
            </div>
        </div>
    </section>
</div>

<dialog id="dlgOnay" class="pbk-pencere" aria-labelledby="dlgOnayBaslik">
    <div class="pencere-baslik">
        <h2 id="dlgOnayBaslik">Onay</h2>
        <button type="button" class="close" data-kapat aria-label="Kapat"><span aria-hidden="true">&times;</span></button>
    </div>
    <div class="pencere-govde"><p>Kayıt işlemi yapılacak. Onaylıyor musunuz?</p></div>
    <div class="pencere-alt">
        <button type="button" class="btn btn-default btn-sm" data-kapat>Vazgeç</button>
        <button type="button" id="btnOnayEvet" class="btn btn-primary btn-sm">Evet</button>
    </div>
</dialog>

@section Baslik {
    <link rel="stylesheet" href="~/css/personelalt.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/personel-kadro.css" asp-append-version="true" />
}
@section Betikler {
    <script src="~/js/personel-hizmetayari.js" asp-append-version="true"></script>
}
