@* ProjeDetay ve AltProjeDetay'ın Raporlar (proje dosyası) ve Yat. Raporları menüleri. *@
<div class="btn-group btn-group-sm rapor-menu" role="group">
    <button type="button" id="btnRaporlar" class="btn btn-default dropdown-toggle" aria-haspopup="true" aria-expanded="false">
        <span class="glyphicon glyphicon-print" aria-hidden="true"></span> Raporlar <span class="caret"></span>
    </button>
    <ul id="lstRaporlar" class="dropdown-menu" aria-labelledby="btnRaporlar">
        <li><button type="button" data-rapor="ment">Proje Dosyası</button></li>
        <li><button type="button" data-rapor="men1">Kapak</button></li>
        <li><button type="button" data-rapor="men2">Özet</button></li>
        <li><button type="button" data-rapor="men3">Tutar</button></li>
        <li><button type="button" data-rapor="men4">Ödenek ve Harcama</button></li>
        <li><button type="button" data-rapor="men5">Dış Kredi</button></li>
        <li><button type="button" data-rapor="men6">Hibe</button></li>
        <li><button type="button" data-rapor="men7">Yılı Teklifi</button></li>
        <li><button type="button" data-rapor="men8">Yılı+1 Teklifi</button></li>
        <li><button type="button" data-rapor="men9">Yılı+2 Teklifi</button></li>
        <li><button type="button" data-rapor="men10">Amaç, Hedef, Gerekçe</button></li>
        <li><button type="button" data-rapor="men11">Ödenek Tablosu (4 Düzey)</button></li>
    </ul>
</div>
<div class="btn-group btn-group-sm rapor-menu" role="group">
    <button type="button" id="btnYatRaporlari" class="btn btn-default dropdown-toggle" aria-haspopup="true" aria-expanded="false">
        <span class="glyphicon glyphicon-list-alt" aria-hidden="true"></span> Yat. Raporları <span class="caret"></span>
    </button>
    <ul id="lstYatRaporlari" class="dropdown-menu" aria-labelledby="btnYatRaporlari"></ul>
</div>
