    <h2 class="bolum-baslik">Uygulandığı İl / İlçeler</h2>
    <div class="ilce-arac">
        <select id="ddlIl" class="form-control input-sm" aria-label="İl"></select>
        <select id="ddlIlce" class="form-control input-sm" aria-label="İlçe"></select>
