@page
@model MasrafPlaniRevizeSorguModel
@{
    ViewData["Title"] = "Bütçe İşlemi Belge Arama";
}
@if (!Model.Yetkili)
{
    <div class="alert alert-warning" role="alert">Bu sayfayı kullanma yetkiniz yok.</div>
    return;
}

<div class="mp-tavan mp-genel mp-revize-sorgu">
    <div class="mp-ust">
        <div class="kutu bolum bolum-secim">
            <h2 class="bolum-baslik">Kriterler</h2>
            <form id="frmSorgu" class="tanim-form mp-form" novalidate>
                <div class="mp-kriter-kolonlar">
                    <div class="mp-kriter-kolon">
                        <div class="form-group">
                            <label class="control-label" for="ddlYil">Yıl</label>
                            <div><input type="number" id="ddlYil" class="form-control input-sm mp-yil sgb-yil" min="2000" max="2100" /></div>
                        </div>
                        <div class="form-group">
                            <label class="control-label" for="ddlDurum">Durum</label>
                            <div><select id="ddlDurum" class="form-control input-sm"></select></div>
                        </div>
                        <div class="form-group">
                            <label class="control-label" for="ddlBirim">Birim Kodu</label>
                            <div><select id="ddlBirim" class="form-control input-sm"></select></div>
                        </div>
                        <div class="form-group">
                            <label class="control-label" for="ddlIslemTur">İşlem Tür</label>
                            <div><select id="ddlIslemTur" class="form-control input-sm"></select></div>
                        </div>
                            <div class="form-group kod-alan" data-agac="17" data-ad="53" data-alan="ky">
                                <label class="control-label" for="txt_ky">Harc. Birimi</label>
                                <div class="kod-satir">
                                    <div class="input-group input-group-sm">
                                        <input type="text" id="txt_ky" class="form-control" autocomplete="off" title="Harc. Birimi kodu (Alt+Aşağı: kod ağacı)" />
                                        <span class="input-group-btn">
                                            <button type="button" class="btn btn-default kod-sec" title="Kod ağacından seç"><span class="glyphicon glyphicon-search" aria-hidden="true"></span><span class="sr-only">Harc. Birimi seç</span></button>
                                            <button type="button" class="btn btn-default kod-temizle" title="Temizle"><span class="glyphicon glyphicon-remove" aria-hidden="true"></span><span class="sr-only">Harc. Birimi temizle</span></button>
                                        </span>
                                    </div>
                                    <span class="kod-ad" aria-live="polite"></span>
                                </div>
                            </div>
                        <div class="form-group">
                            <label class="control-label" for="txtBelgeNo1">Belge No</label>
                            <div class="mp-satir mp-aralik">
                                <input type="text" id="txtBelgeNo1" class="form-control input-sm mp-no" autocomplete="off" aria-label="İlk belge no" />
                                <span aria-hidden="true">-</span>
                                <input type="text" id="txtBelgeNo2" class="form-control input-sm mp-no" autocomplete="off" aria-label="Son belge no" />
                            </div>
                        </div>
                    </div>
                    <div class="mp-kriter-kolon">
                        <div class="form-group">
                            <label class="control-label" for="txtBelgeTarih1">Belge Tarihi</label>
                            <div class="mp-satir mp-aralik">
                                <input type="date" id="txtBelgeTarih1" class="form-control input-sm mp-tarih" aria-label="İlk belge tarihi" />
                                <span aria-hidden="true">-</span>
                                <input type="date" id="txtBelgeTarih2" class="form-control input-sm mp-tarih" aria-label="Son belge tarihi" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label" for="txtDurumTarih1">Durum Tarihi</label>
                            <div class="mp-satir mp-aralik">
                                <input type="date" id="txtDurumTarih1" class="form-control input-sm mp-tarih" aria-label="İlk durum tarihi" />
                                <span aria-hidden="true">-</span>
                                <input type="date" id="txtDurumTarih2" class="form-control input-sm mp-tarih" aria-label="Son durum tarihi" />
                            </div>
                        </div>
                            <div class="form-group kod-alan" data-agac="2" data-ad="2" data-alan="fon">
                                <label class="control-label" for="txt_fon">Fonksiyonel</label>
                                <div class="kod-satir">
                                    <div class="input-group input-group-sm">
                                        <input type="text" id="txt_fon" class="form-control" autocomplete="off" title="Fonksiyonel kodu (Alt+Aşağı: kod ağacı)" />
                                        <span class="input-group-btn">
                                            <button type="button" class="btn btn-default kod-sec" title="Kod ağacından seç"><span class="glyphicon glyphicon-search" aria-hidden="true"></span><span class="sr-only">Fonksiyonel seç</span></button>
                                            <button type="button" class="btn btn-default kod-temizle" title="Temizle"><span class="glyphicon glyphicon-remove" aria-hidden="true"></span><span class="sr-only">Fonksiyonel temizle</span></button>
                                        </span>
                                    </div>
                                    <span class="kod-ad" aria-live="polite"></span>
                                </div>
                            </div>
                            <div class="form-group kod-alan" data-agac="3" data-ad="3" data-alan="fin">
                                <label class="control-label" for="txt_fin">Finans</label>
                                <div class="kod-satir">
                                    <div class="input-group input-group-sm">
                                        <input type="text" id="txt_fin" class="form-control" autocomplete="off" title="Finans kodu (Alt+Aşağı: kod ağacı)" />
                                        <span class="input-group-btn">
                                            <button type="button" class="btn btn-default kod-sec" title="Kod ağacından seç"><span class="glyphicon glyphicon-search" aria-hidden="true"></span><span class="sr-only">Finans seç</span></button>
                                            <button type="button" class="btn btn-default kod-temizle" title="Temizle"><span class="glyphicon glyphicon-remove" aria-hidden="true"></span><span class="sr-only">Finans temizle</span></button>
                                        </span>
                                    </div>
                                    <span class="kod-ad" aria-live="polite"></span>
                                </div>
                            </div>
                            <div class="form-group kod-alan" data-agac="4" data-ad="4" data-alan="eko">
                                <label class="control-label" for="txt_eko">Ekonomik</label>
                                <div class="kod-satir">
                                    <div class="input-group input-group-sm">
                                        <input type="text" id="txt_eko" class="form-control" autocomplete="off" title="Ekonomik kodu (Alt+Aşağı: kod ağacı)" />
                                        <span class="input-group-btn">
                                            <button type="button" class="btn btn-default kod-sec" title="Kod ağacından seç"><span class="glyphicon glyphicon-search" aria-hidden="true"></span><span class="sr-only">Ekonomik seç</span></button>
                                            <button type="button" class="btn btn-default kod-temizle" title="Temizle"><span class="glyphicon glyphicon-remove" aria-hidden="true"></span><span class="sr-only">Ekonomik temizle</span></button>
                                        </span>
                                    </div>
                                    <span class="kod-ad" aria-live="polite"></span>
                                </div>
                            </div>
                            <div class="form-group kod-alan" data-agac="14" data-ad="58" data-alan="peb">
                                <label class="control-label" for="txt_peb">Alt Faaliyet</label>
                                <div class="kod-satir">
                                    <div class="input-group input-group-sm">
                                        <input type="text" id="txt_peb" class="form-control" autocomplete="off" title="Alt Faaliyet kodu (Alt+Aşağı: kod ağacı)" />
                                        <span class="input-group-btn">
                                            <button type="button" class="btn btn-default kod-sec" title="Kod ağacından seç"><span class="glyphicon glyphicon-search" aria-hidden="true"></span><span class="sr-only">Alt Faaliyet seç</span></button>
                                            <button type="button" class="btn btn-default kod-temizle" title="Temizle"><span class="glyphicon glyphicon-remove" aria-hidden="true"></span><span class="sr-only">Alt Faaliyet temizle</span></button>
                                        </span>
                                    </div>
                                    <span class="kod-ad" aria-live="polite"></span>
                                </div>
                            </div>
                        <div class="form-group">
                            <label class="control-label" for="txtIslemYapan">Son İşlem Yapan</label>
                            <div><input type="text" id="txtIslemYapan" class="form-control input-sm" autocomplete="off" /></div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="kutu bolum bolum-tablo">
        <div class="btn-toolbar mp-arac" role="toolbar" aria-label="Belge arama işlemleri">
            <button type="button" id="btnListe" class="btn btn-primary btn-sm">
                <span class="glyphicon glyphicon-search" aria-hidden="true"></span> Listele
            </button>
            <button type="button" class="btn btn-default btn-sm yonetici durum-degistir" data-durum="9" hidden title="Seçili belgeleri iptal eder">
                <span class="glyphicon glyphicon-ban-circle" aria-hidden="true"></span> İptal Et
            </button>
            <button type="button" class="btn btn-default btn-sm yonetici durum-degistir" data-durum="5" hidden title="Seçili belgeleri onaylar">
                <span class="glyphicon glyphicon-ok" aria-hidden="true"></span> Onayla
            </button>
            <button type="button" class="btn btn-default btn-sm yonetici durum-degistir" data-durum="1" hidden title="Seçili belgeleri taslak yapar">
                <span class="glyphicon glyphicon-repeat" aria-hidden="true"></span> Yeni Yap
            </button>
            <div class="btn-group mp-rapor-grup">
                <button type="button" id="btnRapor" class="btn btn-default btn-sm" aria-haspopup="true" aria-expanded="false" aria-controls="mnuRapor">
                    <span class="glyphicon glyphicon-print" aria-hidden="true"></span> Raporlar <span class="caret"></span>
                </button>
                <ul id="mnuRapor" class="mp-menu" role="menu" hidden>
                    <li role="none"><button type="button" role="menuitem" class="btn btn-link btn-sm" data-rapor="1">Tertip durum</button></li>
                    <li role="none"><button type="button" role="menuitem" class="btn btn-link btn-sm" data-rapor="2">İşlem Tertip Toplam</button></li>
                    <li role="none"><button type="button" role="menuitem" class="btn btn-link btn-sm" data-rapor="3">İşlem Detay Liste</button></li>
                </ul>
            </div>
        </div>
        <div id="grdBelgeler" class="mp-grid" aria-label="Belgeler"></div>
    </div>
</div>

<dialog id="dlgKod" class="tanim-pencere mp-agac" aria-labelledby="dlgKodBaslik">
    <div class="pencere-baslik">
        <h2 id="dlgKodBaslik">Kod Seçimi</h2>
        <button type="button" class="close" data-kapat aria-label="Kapat"><span aria-hidden="true">&times;</span></button>
    </div>
    <div class="pencere-govde" id="agacKutu"></div>
    <div class="pencere-alt">
        <button type="button" class="btn btn-default btn-sm" data-kapat>Kapat</button>
    </div>
</dialog>

@section Baslik {
    <link rel="stylesheet" href="~/css/tanim.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mptavan.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/masrafplani.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mprevize.css" asp-append-version="true" />
}
@section Betikler {
    <script src="~/lib/ag-grid/ag-grid-community.min.js"></script>
    <script src="~/js/mptavan-ortak.js" asp-append-version="true"></script>
    <script src="~/js/mprevizesorgu.js" asp-append-version="true"></script>
}
