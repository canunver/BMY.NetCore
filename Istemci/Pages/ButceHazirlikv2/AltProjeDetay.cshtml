@page
@model AltProjeDetayModel
@{
    ViewData["Title"] = "Alt Proje";
}
@if (!Model.Yetkili)
{
    <div class="alert alert-warning" role="alert">Bu sayfayı kullanma yetkiniz yok.</div>
    return;
}

<div class="yat-proje yat-detay" data-sayfa="AltProjeDetay" data-yonetici="@(Model.Yonetici ? "1" : "0")">
    <ul class="nav nav-tabs yat-sekmeler" role="tablist">
        <li role="presentation" class="active"><a href="#sekGenel" role="tab" aria-selected="true">Genel Bilgiler</a></li>
        <li role="presentation"><a href="#sekAmac" role="tab" data-cerceve="AltProjeAmacGiris">Amaç ve Kapsam</a></li>
        <li role="presentation"><a href="#sekIlgili" role="tab" data-cerceve="AltProjeIlgiliGiris">İlgililer</a></li>
        <li role="presentation"><a href="#sekGerekce" role="tab" data-cerceve="AltProjeGerekceGiris">Gerekçe ve Hedefler</a></li>
        <li role="presentation"><a href="#sekProgram" role="tab" data-cerceve="AltProjeDetayProgramiForm">Detay Program</a></li>
        <li role="presentation"><a href="#sekYolluk" role="tab" data-cerceve="AltProjeYollukPlan">Yolluk Plan</a></li>
        <li role="presentation"><a href="#sekYetki" role="tab" data-cerceve="YATYetkiGirisForm">Yetkili Kullanıcılar</a></li>
        <li role="presentation"><a href="#sekDosya" role="tab" data-cerceve="ProjeDosyaEkle">Ek Dosyalar</a></li>
        <li role="presentation"><a href="#sekTertip" role="tab" data-kayitli>Tertipler</a></li>
        @* Bütçe kaynak sekmeleri (AltProjeButceKaynakGiris) buraya eklenir. *@
    </ul>

    <div id="sekGenel" class="yat-panel" role="tabpanel">
        <div class="btn-toolbar yat-arac" role="toolbar">
            <button type="button" id="btnKaydet" class="btn btn-primary btn-sm">
                <span class="glyphicon glyphicon-floppy-disk" aria-hidden="true"></span> Kaydet
            </button>
            <button type="button" id="btnSil" class="btn btn-danger btn-sm" hidden>
                <span class="glyphicon glyphicon-trash" aria-hidden="true"></span> Sil
            </button>
            <button type="button" id="btnKaynakEkle" class="btn btn-default btn-sm" hidden>
                <span class="glyphicon glyphicon-plus" aria-hidden="true"></span> Yeni Bütçe Kaynak
            </button>
            <partial name="_YatRaporMenu" />
            <button type="button" id="btnTasi" class="btn btn-default btn-sm" hidden>
                <span class="glyphicon glyphicon-sort" aria-hidden="true"></span> Taşı
            </button>
        </div>

        <div class="kutu bolum bolum-proje">
            <h2 class="bolum-baslik">Alt Proje Bilgileri</h2>
            <form id="frmGenel" class="tanim-form" novalidate>
                <div class="form-group">
                    <label class="control-label" for="txtAd">Ad</label>
                    <div><input type="text" id="txtAd" class="form-control" maxlength="500" /></div>
                </div>
                <div class="form-group">
                    <label class="control-label" for="ddlBirim">Birim</label>
                    <div><select id="ddlBirim" class="form-control"></select></div>
                </div>
                <div class="form-group">
                    <label class="control-label" for="txtBaslangicYili">Başlangıç - Bitiş Yılı</label>
                    <div class="yil-aralik">
                        <input type="number" id="txtBaslangicYili" class="form-control" min="1900" step="1" aria-label="Başlangıç yılı" />
                        <span>-</span>
                        <input type="number" id="txtBitisYili" class="form-control" min="1900" step="1" aria-label="Bitiş yılı" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="control-label" for="txtProjeAd">Proje</label>
                    <div><input type="text" id="txtProjeAd" class="form-control" readonly /></div>
                </div>
                <div class="form-group">
                    <label class="control-label" for="txtKarakteristik">Karakteristik</label>
                    <div class="ek-alan">
                        <input type="text" id="txtKarakteristik" class="form-control" maxlength="1000" />
                        <button type="button" id="btnKarakteristik" class="btn btn-default btn-sm" title="Karakteristik seç" aria-label="Karakteristik seç">…</button>
                    </div>
                </div>
                <div class="form-group ust-hizali">
                    <label class="control-label" for="txtGerekce">Proje Gerekçesi</label>
                    <div><textarea id="txtGerekce" class="form-control" rows="3" maxlength="300"></textarea></div>
                </div>
                <div class="form-group">
                    <span class="control-label">DPT Raporlarında</span>
                    <div class="secim-satir" role="radiogroup" aria-label="DPT raporlarında">
                        <label class="radio-inline"><input type="radio" name="dptDeVar" value="1" checked /> Görüntülensin</label>
                        <label class="radio-inline"><input type="radio" name="dptDeVar" value="0" /> Görüntülenmesin</label>
                    </div>
                </div>
                <div class="form-group ust-hizali">
                    <span class="control-label">Yat. Bölgesi</span>
                    <div id="lstBolge" class="bolge-liste" role="group" aria-label="Yatırım bölgesi"></div>
                </div>
                <div class="form-group ust-hizali">
                    <label class="control-label" for="txtNot">Not</label>
                    <div><textarea id="txtNot" class="form-control" rows="3"></textarea></div>
                </div>
            </form>
        </div>

        <partial name="_YatIlIlce" />
    </div>

    @foreach (var s in new[] { "sekAmac", "sekIlgili", "sekGerekce", "sekProgram", "sekYolluk", "sekYetki", "sekDosya" })
    {
        <div id="@s" class="yat-panel" role="tabpanel" hidden><iframe class="yat-cerceve" title="@s"></iframe></div>
    }

    <div id="sekTertip" class="yat-panel" role="tabpanel" hidden>
        <div class="kutu bolum bolum-tertip">
            <h2 class="bolum-baslik">Tertipler</h2>
            <p id="tertipBos" class="yat-bos">Alt projeyle ilişkili tertip yok.</p>
            <ul id="lstTertip" class="tertip-liste"></ul>
        </div>
    </div>
</div>

<partial name="_YatDetayPencereler" />

<!-- Yeni bütçe kaynak (eski "Yeni Bütçe Kaynak" penceresi) -->
<dialog id="dlgKaynak" class="tanim-pencere" aria-labelledby="dlgKaynakBaslik">
    <form id="frmKaynak" method="dialog" novalidate>
        <div class="pencere-baslik">
            <h2 id="dlgKaynakBaslik">Yeni Bütçe Kaynak</h2>
            <button type="button" class="close" data-kapat aria-label="Kapat"><span aria-hidden="true">&times;</span></button>
        </div>
        <div class="pencere-govde tanim-form">
            <div class="form-group">
                <label class="control-label" for="txtKaynakAd">Kaynak Adı</label>
                <div><input type="text" id="txtKaynakAd" class="form-control" maxlength="500" /></div>
            </div>
            <div class="form-group ust-hizali">
                <span class="control-label">Kaynak Türü</span>
                <div id="lstKaynakTur" class="secim-satir" role="radiogroup" aria-label="Kaynak türü"></div>
            </div>
            <div class="form-group">
                <span class="control-label">Toplama Dahil</span>
                <div><label class="checkbox-inline"><input type="checkbox" id="chkToplamaDahil" checked /> Evet</label></div>
            </div>
        </div>
        <div class="pencere-alt">
            <button type="button" class="btn btn-default btn-sm" data-kapat>Vazgeç</button>
            <button type="submit" class="btn btn-primary btn-sm">
                <span class="glyphicon glyphicon-floppy-disk" aria-hidden="true"></span> Kaydet
            </button>
        </div>
    </form>
</dialog>

<!-- Alt projeyi başka projeye taşıma (eski wndProjeler) -->
<dialog id="dlgTasi" class="tanim-pencere yat-tasi" aria-labelledby="dlgTasiBaslik">
    <div class="pencere-baslik">
        <h2 id="dlgTasiBaslik">Taşınacak Proje</h2>
        <button type="button" class="close" data-kapat aria-label="Kapat"><span aria-hidden="true">&times;</span></button>
    </div>
    <div class="pencere-govde">
        <div id="grdTasi" class="yat-grid kisa" aria-label="Projeler"></div>
    </div>
    <div class="pencere-alt">
        <button type="button" class="btn btn-default btn-sm" data-kapat>Vazgeç</button>
        <button type="button" id="btnTasiKomut" class="btn btn-primary btn-sm">
            <span class="glyphicon glyphicon-sort" aria-hidden="true"></span> Taşı
        </button>
    </div>
</dialog>

@section Baslik {
    <link rel="stylesheet" href="~/css/tanim.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/yatproje.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/yatprojegiris.css" asp-append-version="true" />
}
@section Betikler {
    <script src="~/lib/ag-grid/ag-grid-community.min.js"></script>
    <script src="~/js/yatprojedetay.js" asp-append-version="true"></script>
}
