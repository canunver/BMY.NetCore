@page
@model TertipDonusumFormuModel
@{
    ViewData["Title"] = "Tertip Dönüşümü";
    // Geniş ekranda sayfa pencereye sığar, tablo kalan alanı doldurur (tanim.css).
    ViewData["GovdeSinif"] = "tanim-sayfa";
}
@if (!Model.Yetkili)
{
    <div class="alert alert-warning" role="alert">Bu sayfayı kullanma yetkiniz yok.</div>
    return;
}

<div class="tanim tavan-faal tek-bolum tertip-donusum" data-yil="@Model.Yil">
    <section>
        <div class="kutu bolum bolum-tavan">
            <h2 class="bolum-baslik">
                <span>Tertip Bilgileri</span>
                <small class="alt-baslik">Boş bırakılan taraf Dönüştür ile doldurulur (analitik tertipten program tertibi ya da tersi).</small>
            </h2>
            <div class="btn-toolbar tavan-arac" role="toolbar" aria-label="Tertip dönüşüm işlemleri">
                <label class="arac-secim" for="txtYil">Yıl
                    <input type="number" id="txtYil" class="form-control input-sm" min="2000" step="1" />
                </label>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" id="btnDonustur" class="btn btn-primary" title="Boş olan tertipleri diğer sütundan üretir">
                        <span class="glyphicon glyphicon-transfer" aria-hidden="true"></span> Dönüştür
                    </button>
                </div>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" id="btnDosyaYukle" class="btn btn-default" title="Excel'deki satırları tabloya getirir (sütunlar: analitik tertip, program tertip)">
                        <span class="glyphicon glyphicon-upload" aria-hidden="true"></span> Dosya Yükle
                    </button>
                    <input type="file" id="dosyaYukle" accept=".xlsx,.xls" hidden />
                    <button type="button" id="btnIndir" class="btn btn-default" title="Tablodaki satırları Excel dosyası olarak indirir">
                        <span class="glyphicon glyphicon-download-alt" aria-hidden="true"></span> İndir
                    </button>
                </div>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" id="btnYapistir" class="btn btn-default" title="Panodaki satırları (analitik, program; sekmeyle ayrılmış) tablonun sonuna ekler">
                        <span class="glyphicon glyphicon-paste" aria-hidden="true"></span> Yapıştır
                    </button>
                    <button type="button" id="btnKopyala" class="btn btn-default" title="Tablodaki satırları panoya kopyalar">
                        <span class="glyphicon glyphicon-copy" aria-hidden="true"></span> Kopyala
                    </button>
                    <button type="button" id="btnTemizle" class="btn btn-default" title="Tabloyu boşaltır">
                        <span class="glyphicon glyphicon-erase" aria-hidden="true"></span> Temizle
                    </button>
                </div>
            </div>
            <div id="grdTertip" class="tavan-grid" aria-label="Tertipler"></div>
        </div>
    </section>
</div>

<!-- Pano okunamazsa veri buraya yapıştırılır -->
<dialog id="dlgYapistir" class="tanim-pencere butce-rakam-yapistir" aria-labelledby="dlgYapistirBaslik">
    <div class="pencere-baslik">
        <h2 id="dlgYapistirBaslik">Yapıştır</h2>
        <button type="button" class="close" data-kapat aria-label="Kapat"><span aria-hidden="true">&times;</span></button>
    </div>
    <div class="pencere-govde">
        <p class="help-block">Excel'den kopyaladığınız satırları buraya yapıştırınız (Ctrl+V). Sütunlar: analitik tertip, program tertip.</p>
        <textarea id="txtYapistir" class="form-control" rows="8" aria-label="Yapıştırılacak veri"></textarea>
    </div>
    <div class="pencere-alt">
        <button type="button" class="btn btn-default btn-sm" data-kapat>Vazgeç</button>
        <button type="button" id="btnYapistirTamam" class="btn btn-primary btn-sm">Yapıştır</button>
    </div>
</dialog>

<!-- Kopyala: pano yazılamazsa metin burada seçili gösterilir -->
<dialog id="dlgKopyala" class="tanim-pencere butce-rakam-yapistir" aria-labelledby="dlgKopyalaBaslik">
    <div class="pencere-baslik">
        <h2 id="dlgKopyalaBaslik">Kopyala</h2>
        <button type="button" class="close" data-kapat aria-label="Kapat"><span aria-hidden="true">&times;</span></button>
    </div>
    <div class="pencere-govde">
        <p class="help-block">Metin seçili; Ctrl+C ile kopyalayınız.</p>
        <textarea id="txtKopyala" class="form-control" rows="8" readonly aria-label="Kopyalanacak veri"></textarea>
    </div>
    <div class="pencere-alt">
        <button type="button" class="btn btn-default btn-sm" data-kapat>Kapat</button>
    </div>
</dialog>

@section Baslik {
    <link rel="stylesheet" href="~/css/tanim.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tavanfaal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/butcerakam.css" asp-append-version="true" />
}
@section Betikler {
    <script src="~/lib/ag-grid/ag-grid-community.min.js"></script>
    <script src="~/js/tertipdonusum.js" asp-append-version="true"></script>
}
