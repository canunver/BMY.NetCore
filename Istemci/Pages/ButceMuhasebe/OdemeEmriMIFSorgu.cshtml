@page
@model OdemeEmriMIFSorguModel
@{
    ViewData["Title"] = "Ödeme Emri / MİF Belge Arama";
    ViewData["GovdeSinif"] = "oms-sayfa";
}
@if (!Model.Yetkili)
{
    <div class="alert alert-warning" role="alert">Bu sayfayı kullanma yetkiniz yok.</div>
    return;
}

<div class="oem-sorgu">
    <!-- Sorgu alanları (eski Sorgu Alanları PropertyGrid'i; daraltılabilir) -->
    <section class="kutu bolum bolum-kriter oms-kriter" id="pnlKriter" aria-label="Sorgu alanları">
        <h2 class="bolum-baslik">
            Sorgu Alanları
            <span class="oms-baslik-tuslar">
                <button type="button" id="btnYardim" class="btn btn-default btn-xs oms-yardim" title="Açıklama" aria-expanded="false" aria-controls="pnlYardim">?</button>
                <button type="button" id="btnKriterGizle" class="btn btn-default btn-xs" title="Sorgu alanlarını gizle" aria-controls="pnlKriter">
                    <span class="glyphicon glyphicon-chevron-left" aria-hidden="true"></span><span class="sr-only">Sorgu alanlarını gizle</span>
                </button>
            </span>
        </h2>
        <div id="pnlYardim" class="oms-ipucu" hidden>
            Yıl ve Durum zorunludur. Belge No 9 haneden kısa yazılırsa başına kurum kodu eklenir. Belge numarasına tıklanınca ya da
            satıra çift tıklanınca belge "Belge Düzenleme" sekmesinde açılır; Durum'a tıklanınca belgenin tarihçesi gösterilir.
            <b>Liste İşlemleri</b>, <b>Yevmiye</b>, <b>Çek</b> ve <b>İstatistik</b> işlemleri listede işaretlenen belgelere uygulanır.
            Çek İşlemleri / <b>Yazdır</b> sorgu alanlarına göre çek listesini döker: çek no yazılmışsa o çek numaralı belgeler,
            yazılmamışsa 103 hesaba alacak kaydı olan yevmiyeli ödeme emirleri.
        </div>
        <form id="frmKriter" class="tanim-form oms-alanlar" novalidate>
            <div class="form-group">
                <label class="control-label" for="txtYil">Yıl</label>
                <div><input type="number" id="txtYil" class="form-control input-sm oms-yil sgb-yil" min="2006" step="1" /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="ddlDurum">Durum</label>
                <div><select id="ddlDurum" class="form-control input-sm"></select></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="ddlBelgeTur">Belge Türü</label>
                <div><select id="ddlBelgeTur" class="form-control input-sm"></select></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtMuhasebe">Muhasebe / Birim</label>
                <div id="muhBirim"></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtYevmiyeNo1">Yevmiye No</label>
                <div class="oms-aralik">
                    <input type="text" id="txtYevmiyeNo1" class="form-control input-sm" maxlength="12" autocomplete="off" placeholder="&gt;=" aria-label="Yevmiye no en az" />
                    <span class="oms-ayrac">-</span>
                    <input type="text" id="txtYevmiyeNo2" class="form-control input-sm" maxlength="12" autocomplete="off" placeholder="&lt;=" aria-label="Yevmiye no en çok" />
                </div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtBelgeNo1">Belge No</label>
                <div class="oms-aralik">
                    <input type="text" id="txtBelgeNo1" class="form-control input-sm" maxlength="20" autocomplete="off" placeholder="&gt;=" aria-label="Belge no en az" />
                    <span class="oms-ayrac">-</span>
                    <input type="text" id="txtBelgeNo2" class="form-control input-sm" maxlength="20" autocomplete="off" placeholder="&lt;=" aria-label="Belge no en çok" />
                </div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtBelgeTarih1">Belge Tarihi</label>
                <div class="oms-aralik">
                    <input type="date" id="txtBelgeTarih1" class="form-control input-sm" title="Belge tarihi &gt;=" aria-label="Belge tarihi en az" />
                    <span class="oms-ayrac">-</span>
                    <input type="date" id="txtBelgeTarih2" class="form-control input-sm" title="Belge tarihi &lt;=" aria-label="Belge tarihi en çok" />
                </div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtHesapNo">Hesap Kodu</label>
                <div><input type="text" id="txtHesapNo" class="form-control input-sm oms-hesap" maxlength="40" /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtAltHesapNo">Alt Hesap Kodu</label>
                <div class="input-group input-group-sm">
                    <input type="text" id="txtAltHesapNo" class="form-control" maxlength="80" autocomplete="off" list="lstAltHesap" title="En az üç karakter yazınca öneriler gelir" />
                    <span class="input-group-btn">
                        <button type="button" id="btnAltHesapSec" class="btn btn-default" title="Kişi / firma ara"><span class="glyphicon glyphicon-search" aria-hidden="true"></span><span class="sr-only">Alt hesap ara</span></button>
                    </span>
                </div>
                <datalist id="lstAltHesap"></datalist>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtIlgiliAd">Adı Soyadı/Ünvanı</label>
                <div><input type="text" id="txtIlgiliAd" class="form-control input-sm" maxlength="100" autocomplete="off" /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtIlgiliNo">T.C./Vergi No</label>
                <div><input type="text" id="txtIlgiliNo" class="form-control input-sm" maxlength="20" autocomplete="off" /></div>
            </div>
            <partial name="_OdenekDurumKodlar" />
            <div class="form-group">
                <label class="control-label" for="txtYevmiyeTarih1">Yevmiye Tarih</label>
                <div class="oms-aralik">
                    <input type="date" id="txtYevmiyeTarih1" class="form-control input-sm" aria-label="Yevmiye tarihi en az" />
                    <span class="oms-ayrac">-</span>
                    <input type="date" id="txtYevmiyeTarih2" class="form-control input-sm" aria-label="Yevmiye tarihi en çok" />
                </div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtDurumTarih1">Durum Tarih</label>
                <div class="oms-aralik">
                    <input type="date" id="txtDurumTarih1" class="form-control input-sm" aria-label="Durum tarihi en az" />
                    <span class="oms-ayrac">-</span>
                    <input type="date" id="txtDurumTarih2" class="form-control input-sm" aria-label="Durum tarihi en çok" />
                </div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtBorc">Borç</label>
                <div><input type="text" id="txtBorc" class="form-control input-sm oms-sag" maxlength="20" autocomplete="off" inputmode="decimal" /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtAlacak">Alacak</label>
                <div><input type="text" id="txtAlacak" class="form-control input-sm oms-sag" maxlength="20" autocomplete="off" inputmode="decimal" /></div>
            </div>
            <div class="form-group ust-hizali">
                <span class="control-label" id="lblFisTur">Fiş Türü</span>
                <div id="fisTurler" class="oms-fisturler" role="group" aria-labelledby="lblFisTur"></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtIslemYapan">En Son İşlem Yapan</label>
                <div><input type="text" id="txtIslemYapan" class="form-control input-sm" maxlength="50" autocomplete="off" /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtAciklama">Açıklama</label>
                <div><input type="text" id="txtAciklama" class="form-control input-sm" maxlength="200" autocomplete="off" /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtCekNoSorgu">Çek/Gönderme No</label>
                <div><input type="text" id="txtCekNoSorgu" class="form-control input-sm" maxlength="30" autocomplete="off" /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtOdEsBeTur">Öd.Es.Bel.Türü</label>
                <div><input type="text" id="txtOdEsBeTur" class="form-control input-sm" maxlength="50" autocomplete="off" /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtOdEsBeNo">Öd.Es.Bel.Nosu</label>
                <div><input type="text" id="txtOdEsBeNo" class="form-control input-sm" maxlength="50" autocomplete="off" /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtOdEsTarih">Öd.Es.Bel.Tarihi</label>
                <div><input type="date" id="txtOdEsTarih" class="form-control input-sm" /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtYatirimProjeNo">DPT Proje No</label>
                <div><input type="text" id="txtYatirimProjeNo" class="form-control input-sm" maxlength="30" autocomplete="off" /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtSurecNo">Süreç No</label>
                <div><input type="text" id="txtSurecNo" class="form-control input-sm" maxlength="20" autocomplete="off" placeholder="yıl/no ya da no" /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtIhaleMadde">İhale Madde</label>
                <div><input type="text" id="txtIhaleMadde" class="form-control input-sm" maxlength="50" autocomplete="off" /></div>
            </div>
            <div class="form-group" id="grpIst1" hidden>
                <label class="control-label" for="ddlIst1" id="lblIst1">İst Kod 1</label>
                <div><select id="ddlIst1" class="form-control input-sm"></select></div>
            </div>
            <div class="form-group" id="grpIst2" hidden>
                <label class="control-label" for="ddlIst2" id="lblIst2">İst Kod 2</label>
                <div><select id="ddlIst2" class="form-control input-sm"></select></div>
            </div>
            <div class="oms-kriter-tuslar">
                <button type="button" id="btnKriterTemizle" class="btn btn-default btn-sm"><span class="glyphicon glyphicon-erase" aria-hidden="true"></span> Temizle</button>
            </div>
        </form>
    </section>

    <!-- Sonuç (eski grdListeMIF) -->
    <section class="kutu bolum bolum-liste oms-liste" aria-label="Belgeler">
        <div class="btn-toolbar oms-arac" role="toolbar" aria-label="Liste işlemleri">
            <button type="button" id="btnKriterGoster" class="btn btn-default btn-sm" title="Sorgu alanlarını göster" aria-controls="pnlKriter" hidden>
                <span class="glyphicon glyphicon-chevron-right" aria-hidden="true"></span> Sorgu Alanları
            </button>
            <button type="submit" form="frmKriter" id="btnListe" class="btn btn-primary btn-sm"><span class="glyphicon glyphicon-list" aria-hidden="true"></span> Listele</button>
            <button type="button" id="btnListeYazdir" class="btn btn-default btn-sm"><span class="glyphicon glyphicon-print" aria-hidden="true"></span> Liste Yazdır</button>
            <div class="oms-menu">
                <button type="button" class="btn btn-default btn-sm dropdown-toggle" aria-haspopup="true" aria-expanded="false">
                    <span class="glyphicon glyphicon-tasks" aria-hidden="true"></span> Liste İşlemleri <span class="caret"></span>
                </button>
                <ul class="dropdown-menu">
                    <li><a href="#" class="durum-islem" data-islem="onayla"><span class="glyphicon glyphicon-ok" aria-hidden="true"></span> Onayla</a></li>
                    <li><a href="#" class="durum-islem" data-islem="onaykaldir"><span class="glyphicon glyphicon-remove" aria-hidden="true"></span> Onay Kaldır</a></li>
                    <li><a href="#" id="mnBelgeYazdir"><span class="glyphicon glyphicon-print" aria-hidden="true"></span> Yazdır</a></li>
                    <li><a href="#" class="durum-islem" data-islem="iptal"><span class="glyphicon glyphicon-trash" aria-hidden="true"></span> İptal Et</a></li>
                </ul>
            </div>
            <button type="button" id="btnYevmiye" class="btn btn-default btn-sm"><span class="glyphicon glyphicon-edit" aria-hidden="true"></span> Yevmiye İşlemleri</button>
            <button type="button" id="btnCek" class="btn btn-default btn-sm"><span class="glyphicon glyphicon-edit" aria-hidden="true"></span> Çek İşlemleri</button>
            <button type="button" id="btnIstatistik" class="btn btn-default btn-sm" hidden><span class="glyphicon glyphicon-paperclip" aria-hidden="true"></span> İstatistik İşlemleri</button>
            <div class="oms-menu" id="mnSutunlar">
                <button type="button" class="btn btn-default btn-sm dropdown-toggle" aria-haspopup="true" aria-expanded="false">
                    <span class="glyphicon glyphicon-th-list" aria-hidden="true"></span> Sütunlar <span class="caret"></span>
                </button>
                <ul class="dropdown-menu oms-sutun-liste" aria-label="Görünen sütunlar"></ul>
            </div>
            <span class="oms-ozet" id="lblOzet" aria-live="polite"></span>
        </div>
        <div id="grdListe" class="oms-grid" aria-label="Ödeme emri / MİF belgeleri"></div>
    </section>
</div>

<partial name="_OdenekDurumKodPencere" />

<!-- Yevmiye İşlemleri (eski menuYevmiye) -->
<dialog id="dlgYevmiye" class="tanim-pencere oms-pencere" aria-labelledby="dlgYevmiyeBaslik">
    <form id="frmYevmiye" novalidate>
        <div class="pencere-baslik">
            <h2 id="dlgYevmiyeBaslik">Yevmiye İşlemleri</h2>
            <button type="button" class="close" data-kapat aria-label="Kapat"><span aria-hidden="true">&times;</span></button>
        </div>
        <div class="pencere-govde tanim-form oms-alanlar">
            <p class="oms-not" id="lblYevmiyeSecili"></p>
            <div class="form-group">
                <label class="control-label" for="txtIslemYevmiyeNo">Yevmiye No</label>
                <div><input type="text" id="txtIslemYevmiyeNo" class="form-control input-sm" maxlength="12" autocomplete="off" title="Boş bırakılırsa sıradaki numara verilir" /></div>
            </div>
            <div class="form-group">
                <span class="control-label"></span>
                <div><label class="oms-secenek"><input type="checkbox" id="chkIslemYevmiye" checked /> Yevmiye tarihi ile belge tarihi aynı olsun</label></div>
            </div>
            <div class="form-group" id="grpIslemYevmiyeTarihi" hidden>
                <label class="control-label" for="txtIslemYevmiyeTarihi">Yevmiye Tarihi</label>
                <div><input type="date" id="txtIslemYevmiyeTarihi" class="form-control input-sm" /></div>
            </div>
        </div>
        <div class="pencere-alt">
            <button type="button" class="btn btn-default btn-sm" data-kapat>Kapat</button>
            <button type="button" id="btnYevmiyeNoKaldir" class="btn btn-default btn-sm"><span class="glyphicon glyphicon-minus" aria-hidden="true"></span> Yevmiye No Kaldır</button>
            <button type="submit" id="btnYevmiyeVer" class="btn btn-primary btn-sm"><span class="glyphicon glyphicon-plus" aria-hidden="true"></span> Yevmiye No Ver</button>
        </div>
    </form>
</dialog>

<!-- Çek İşlemleri (eski menuCek) -->
<dialog id="dlgCek" class="tanim-pencere oms-pencere" aria-labelledby="dlgCekBaslik">
    <form id="frmCek" novalidate>
        <div class="pencere-baslik">
            <h2 id="dlgCekBaslik">Çek İşlemleri</h2>
            <button type="button" class="close" data-kapat aria-label="Kapat"><span aria-hidden="true">&times;</span></button>
        </div>
        <div class="pencere-govde tanim-form oms-alanlar">
            <p class="oms-not" id="lblCekSecili"></p>
            <div class="form-group">
                <label class="control-label" for="txtIslemCekNo">Çek No / Gönderme Emri No</label>
                <div><input type="text" id="txtIslemCekNo" class="form-control input-sm" maxlength="30" autocomplete="off" /></div>
            </div>
            <p class="oms-not">Yazdır seçili belgelere bakmaz; sorgu alanlarına ve bu çek numarasına göre listeler.</p>
        </div>
        <div class="pencere-alt">
            <button type="button" class="btn btn-default btn-sm" data-kapat>Kapat</button>
            <button type="button" id="btnCekNoYazdir" class="btn btn-default btn-sm"><span class="glyphicon glyphicon-print" aria-hidden="true"></span> Yazdır</button>
            <button type="button" id="btnCekNoKaldir" class="btn btn-default btn-sm"><span class="glyphicon glyphicon-minus" aria-hidden="true"></span> No Kaldır</button>
            <button type="submit" id="btnCekNoVer" class="btn btn-primary btn-sm"><span class="glyphicon glyphicon-plus" aria-hidden="true"></span> No Güncelle</button>
        </div>
    </form>
</dialog>

<!-- İstatistik İşlemleri (eski wndIst) -->
<dialog id="dlgIst" class="tanim-pencere oms-pencere" aria-labelledby="dlgIstBaslik">
    <form id="frmIst" novalidate>
        <div class="pencere-baslik">
            <h2 id="dlgIstBaslik">İstatistik İşlemleri</h2>
            <button type="button" class="close" data-kapat aria-label="Kapat"><span aria-hidden="true">&times;</span></button>
        </div>
        <div class="pencere-govde tanim-form oms-alanlar">
            <p class="oms-not" id="lblIstSecili"></p>
            <div class="form-group" id="grpIstAta1" hidden>
                <label class="control-label" for="ddlIstAta1" id="lblIstAta1">Kod 1</label>
                <div><select id="ddlIstAta1" class="form-control input-sm"></select></div>
            </div>
            <div class="form-group" id="grpIstAta2" hidden>
                <label class="control-label" for="ddlIstAta2" id="lblIstAta2">Kod 2</label>
                <div><select id="ddlIstAta2" class="form-control input-sm"></select></div>
            </div>
        </div>
        <div class="pencere-alt">
            <button type="button" class="btn btn-default btn-sm" data-kapat>Kapat</button>
            <button type="submit" id="btnIstAta" class="btn btn-primary btn-sm"><span class="glyphicon glyphicon-plus" aria-hidden="true"></span> Değerleri Yaz</button>
        </div>
    </form>
</dialog>

<!-- Belge tarihçesi (eski BelgeTarihce.aspx) -->
<dialog id="dlgTarihce" class="tanim-pencere oms-pencere-genis" aria-labelledby="dlgTarihceBaslik">
    <div class="pencere-baslik">
        <h2 id="dlgTarihceBaslik">Belge Tarihçesi</h2>
        <button type="button" class="close" data-kapat aria-label="Kapat"><span aria-hidden="true">&times;</span></button>
    </div>
    <div class="pencere-govde">
        <p class="oms-tarihce-belge" id="lblTarihceBelge"></p>
        <div id="grdTarihce" class="oms-grid-kucuk" aria-label="Tarihçe"></div>
    </div>
    <div class="pencere-alt">
        <button type="button" class="btn btn-default btn-sm" data-kapat>Kapat</button>
    </div>
</dialog>

<!-- Onay sorusu (eski Confirmation) -->
<dialog id="dlgSoru" class="tanim-pencere" aria-labelledby="dlgSoruBaslik">
    <div class="pencere-baslik">
        <h2 id="dlgSoruBaslik">İşlem Onayı</h2>
        <button type="button" class="close" data-kapat aria-label="Kapat"><span aria-hidden="true">&times;</span></button>
    </div>
    <div class="pencere-govde">
        <p id="soruMetin"></p>
    </div>
    <div class="pencere-alt">
        <button type="button" class="btn btn-default btn-sm" data-kapat>Vazgeç</button>
        <button type="button" id="btnSoruEvet" class="btn btn-primary btn-sm">Evet</button>
    </div>
</dialog>

@section Baslik {
    <link rel="stylesheet" href="~/css/tanim.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/muhbirim.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/makbuz.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hesapkodu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/odenekdurum.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/odemeemrimifliste.css" asp-append-version="true" />
}
@section Betikler {
    <script src="~/lib/ag-grid/ag-grid-community.min.js"></script>
    <script src="~/js/muhbirim.js" asp-append-version="true"></script>
    <script src="~/js/makbuzsecim.js" asp-append-version="true"></script>
    <script src="~/js/hesapkodu.js" asp-append-version="true"></script>
    <script src="~/js/odemeemrimifliste.js" asp-append-version="true"></script>
}
