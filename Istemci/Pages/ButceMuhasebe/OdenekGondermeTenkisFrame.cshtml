@page
@model OdenekGondermeTenkisFrameModel
@{
    ViewData["Title"] = Model.Baslik;
    ViewData["GovdeSinif"] = "og-cerceve-sayfa";
}
@if (!Model.BelgeTurVar)
{
    <div class="alert alert-warning" role="alert">Belge türü bilgisi alınamadı.</div>
    return;
}
@if (!Model.Yetkili)
{
    <div class="alert alert-warning" role="alert">Bu sayfayı kullanma yetkiniz yok.</div>
    return;
}

<!-- Eski çerçevedeki iki sekme: Belge Düzenleme (Form) ve Belge Arama (Liste). Liste'den açılan belge Form sekmesinde gösterilir. -->
<div class="og-cerceve">
    <ul class="nav nav-tabs og-sekmeler" role="tablist">
        <li role="presentation" class="active"><a href="#" role="tab" data-sekme="form" aria-selected="true">Belge Düzenleme</a></li>
        <li role="presentation"><a href="#" role="tab" data-sekme="liste" aria-selected="false">Belge Arama</a></li>
    </ul>
    <iframe id="cerceveForm" class="og-alt-cerceve" data-sekme="form" title="Belge Düzenleme"
            src="OdenekGondermeTenkisMPExt?@Html.Raw(Model.Parametreler)&menuYok=1"></iframe>
    <iframe id="cerceveListe" class="og-alt-cerceve" data-sekme="liste" title="Belge Arama" hidden
            data-src="OdenekGondermeTenkisSorgu?@Html.Raw(Model.Parametreler)&menuYok=1"></iframe>
</div>

@section Baslik {
    <link rel="stylesheet" href="~/css/odenekgonderme.css" asp-append-version="true" />
}
@section Betikler {
    <script src="~/js/odenekgondermecerceve.js" asp-append-version="true"></script>
}
