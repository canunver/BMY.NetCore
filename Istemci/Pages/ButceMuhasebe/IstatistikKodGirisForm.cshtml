@page
@model IstatistikKodGirisFormModel
@{
    ViewData["Title"] = "İstatistik Kod Girişi";
    ViewData["GovdeSinif"] = "tanim-sayfa";
}
@if (!Model.Yetkili)
{
    <div class="alert alert-warning" role="alert">Bu sayfayı kullanma yetkiniz yok.</div>
    return;
}

<div class="tanim mt-tek muh-tanim">
    <section>
        <div class="kutu bolum izgarali">
            <h2 class="bolum-baslik">İstatistik Kodu Seçim Değerleri</h2>
            <div class="mt-arac" role="toolbar" aria-label="İşlemler">
                <label for="isKod">İstatistik Kodu</label>
                <select id="isKod" class="form-control input-sm"></select>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" id="btnKodDuzenle" class="btn btn-default" title="Seçili istatistik kodunun adını, zorunluluğunu ve ek alanlarını düzenler"><span class="glyphicon glyphicon-pencil" aria-hidden="true"></span><span class="sr-only">Kodu düzenle</span></button>
                    <button type="button" id="btnKodEkle" class="btn btn-default" title="Yeni istatistik kodu"><span class="glyphicon glyphicon-plus" aria-hidden="true"></span><span class="sr-only">Yeni istatistik kodu</span></button>
                </div>
                <button type="button" id="btnOku" class="btn btn-default btn-sm"><span class="glyphicon glyphicon-refresh" aria-hidden="true"></span> Oku</button>
                <button type="button" id="btnKaydet" class="btn btn-primary btn-sm"><span class="glyphicon glyphicon-floppy-disk" aria-hidden="true"></span> Kaydet</button>
                <div class="btn-group btn-group-sm sag" role="group">
                    <button type="button" id="btnSatirEkle" class="btn btn-default"><span class="glyphicon glyphicon-plus" aria-hidden="true"></span> Satır Ekle</button>
                    <button type="button" id="btnSatirSil" class="btn btn-default"><span class="glyphicon glyphicon-minus" aria-hidden="true"></span> Satır Sil</button>
                </div>
            </div>
            <div id="grdDeger" class="tanim-grid"></div>
        </div>
    </section>
</div>

<dialog id="dlgKod" class="tanim-pencere" aria-labelledby="dlgKodBaslik">
    <div class="pencere-baslik">
        <h2 id="dlgKodBaslik">İstatistik Kodu</h2>
        <button type="button" class="close" data-kapat aria-label="Kapat"><span aria-hidden="true">&times;</span></button>
    </div>
    <div class="pencere-govde">
        <form id="frmKod" class="tanim-form" novalidate>
            <div class="form-group">
                <label class="control-label" for="kdKod">Kod</label>
                <div><input type="text" id="kdKod" class="form-control kisa" readonly data-alan="kod" title="Yeni kodda kayıttan sonra verilir" /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="kdAd">Ad</label>
                <div><input type="text" id="kdAd" class="form-control" data-alan="ad" /></div>
            </div>
            <div class="form-group">
                <span class="control-label">Zorunluluk</span>
                <div class="tanim-secenekler">
                    <label><input type="checkbox" data-alan="oeZorunlu" /> Öd. Emri Zorunlu</label>
                    <label><input type="checkbox" data-alan="mifZorunlu" /> MİF Zorunlu</label>
                </div>
            </div>
            <div class="form-group">
                <label class="control-label" for="kdEk1">Ek Alan 1 Adı</label>
                <div><input type="text" id="kdEk1" class="form-control" data-alan="ekAlan1Ad" /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="kdEk2">Ek Alan 2 Adı</label>
                <div><input type="text" id="kdEk2" class="form-control" data-alan="ekAlan2Ad" /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="kdEk3">Ek Alan 3 Adı</label>
                <div><input type="text" id="kdEk3" class="form-control" data-alan="ekAlan3Ad" /></div>
            </div>
        </form>
        <p class="text-muted" style="margin:0">Adı boş bırakılan ek alan seçim değerleri tablosunda gösterilmez.</p>
    </div>
    <div class="pencere-alt">
        <button type="button" class="btn btn-default btn-sm" data-kapat>Kapat</button>
        <button type="button" id="btnKodKaydet" class="btn btn-primary btn-sm"><span class="glyphicon glyphicon-ok" aria-hidden="true"></span> Kaydet</button>
    </div>
</dialog>

@section Baslik {
    <link rel="stylesheet" href="~/css/tanim.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/muhtanim.css" asp-append-version="true" />
}
@section Betikler {
    <script src="~/lib/ag-grid/ag-grid-community.min.js"></script>
    <script src="~/js/muhtanim.js" asp-append-version="true"></script>
    <script src="~/js/muhtanim-istatistik.js" asp-append-version="true"></script>
}
