@page
@model YilSonuIslemleriModel
@{
    ViewData["Title"] = "Yıl Sonu Kapatma İşlemleri";
    ViewData["GovdeSinif"] = "avans-sayfa";
}
@if (!Model.Yetkili)
{
    <div class="alert alert-warning" role="alert">Bu sayfayı kullanma yetkiniz yok.</div>
    return;
}

<div class="avans yil-sonu">
    <section class="kutu bolum bolum-kriter">
        <h2 class="bolum-baslik">Yıl Sonu Kapatma İşlemleri
            <button type="button" class="btn btn-link btn-xs avans-yardim-dugme" data-yardim="#ysYardim" title="Yardım" aria-label="Yardım">
                <span class="glyphicon glyphicon-question-sign" aria-hidden="true"></span>
            </button>
            <a class="btn btn-link btn-xs ys-pdf" href="~/yardim/YilSonuKapatmaYardim.pdf" target="_blank" rel="noopener" title="Yıl sonu kapatma yardım dokümanı (PDF)">
                <span class="glyphicon glyphicon-book" aria-hidden="true"></span> Yardım Dokümanı
            </a>
        </h2>
        <div id="ysYardim" class="alert alert-info avans-yardim" hidden>
            Yıl, Muhasebe / Birim ve Belge Tarihi girip <b>Listele</b>'ye basın. Her satırda <b>Belge Oluştur</b> o türün kapanış belgesini
            kaydeder (yevmiye numarası verilir); <b>Belge Raporu</b> kayıt yapmadan oluşacak belgenin satırlarını Excel'e döker.
            Daha önce numara ayrılmışsa Belge No hücresine yazabilirsiniz.
        </div>
        <form id="frmKriter" class="tanim-form avans-alanlar" onsubmit="return false;">
            <div class="form-group">
                <label class="control-label" for="txtYil">Yıl</label>
                <div><input type="number" id="txtYil" class="form-control input-sm sgb-yil" /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtMuhasebe">Muhasebe / Birim</label>
                <div id="muhBirim"></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtBelgeTarih">Belge Tarihi</label>
                <div><input type="date" id="txtBelgeTarih" class="form-control input-sm ys-tarih" /></div>
            </div>
        </form>
    </section>

    <section class="kutu bolum bolum-liste">
        <div class="avans-arac" role="toolbar" aria-label="İşlemler">
            <button type="button" id="btnListele" class="btn btn-primary btn-sm">
                <span class="glyphicon glyphicon-search" aria-hidden="true"></span> Listele
            </button>
            <span id="lblOzet" class="avans-ozet"></span>
        </div>
        <div id="grdListe" class="avans-grid" aria-label="Yıl sonu işlemleri"></div>
    </section>
</div>

@section Baslik {
    <link rel="stylesheet" href="~/css/tanim.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/muhbirim.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/avans.css" asp-append-version="true" />
    <style>
        .yil-sonu .ys-tarih { width: 150px; }
        .yil-sonu .ys-pdf { margin-left: auto; font-weight: normal; }
        .yil-sonu .ys-komut { padding: 0 4px; margin-right: 4px; line-height: 1.2; }
        .yil-sonu .ys-yazilir { background: #fff; }
        .yil-sonu .ys-salt { background: #fff8d6; }
    </style>
}
@section Betikler {
    <script src="~/lib/ag-grid/ag-grid-community.min.js"></script>
    <script src="~/js/muhbirim.js" asp-append-version="true"></script>
    <script src="~/js/yilsonuislemleri.js" asp-append-version="true"></script>
}
