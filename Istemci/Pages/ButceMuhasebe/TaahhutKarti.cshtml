<dialog id="dlgAcilis" class="tanim-pencere th-pencere" aria-labelledby="dlgAcilisBaslik">
    <div class="pencere-baslik"><h2 id="dlgAcilisBaslik">Açılış Tahakkuku Hesap Kodları</h2><button type="button" class="close" data-kapat aria-label="Kapat"><span aria-hidden="true">&times;</span></button></div>
    <div class="pencere-govde">
        <div class="tanim-form avans-alanlar">
            <div class="form-group">
                <label class="control-label" for="txtAcBorc">Borç Hesap Kodu</label>
                <div><input type="text" id="txtAcBorc" class="form-control input-sm th-hesap" autocomplete="off" /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtAcAlacak">Alacak Hesap Kodu</label>
                <div><input type="text" id="txtAcAlacak" class="form-control input-sm th-hesap" autocomplete="off" /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtAcYil">Ödeme Emri Belge Yıl</label>
                <div><input type="number" id="txtAcYil" class="form-control input-sm sgb-yil" min="1980" /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="txtAcBelgeNo">Ödeme Emri Belge No</label>
                <div><input type="text" id="txtAcBelgeNo" class="form-control input-sm th-orta" inputmode="numeric" title="Oluşturulacak belgeye daha önceki bir belgenin numarasını vermek için yazın, aksi halde boş bırakın" /></div>
            </div>
        </div>
    </div>
    <div class="pencere-alt">
        <button type="button" class="btn btn-default btn-sm" data-kapat>Kapat</button>
        <button type="button" id="btnTahakkukOlustur" class="btn btn-primary btn-sm"><span class="glyphicon glyphicon-edit" aria-hidden="true"></span> Tahakkuku Oluştur</button>
    </div>
</dialog>

<dialog id="dlgDegerArtisi" class="tanim-pencere th-pencere" aria-labelledby="dlgDegerArtisiBaslik">
    <div class="pencere-baslik"><h2 id="dlgDegerArtisiBaslik">Değer Artışı Düzenleme</h2><button type="button" class="close" data-kapat aria-label="Kapat"><span aria-hidden="true">&times;</span></button></div>
    <div class="pencere-govde">
        <form id="frmDA" class="tanim-form avans-alanlar" novalidate>
            <input type="hidden" data-alan="kod" />
            <input type="hidden" data-alan="odemeEmriYil" />
            <input type="hidden" data-alan="odemeEmriNo" />
            <div class="form-group">
                <label class="control-label" for="daSozTar">Söz. Tarihi</label>
                <div><input type="date" id="daSozTar" class="form-control input-sm th-tarih" data-alan="sozlesmeTarihi" /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="daOnayTar">Onay Tarihi</label>
                <div><input type="date" id="daOnayTar" class="form-control input-sm th-tarih" data-alan="onayTarihi" /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="daSozTutar">Söz. Tutarı</label>
                <div><input type="text" id="daSozTutar" class="form-control input-sm th-tutar" inputmode="decimal" data-alan="sozlesmeTutari" /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="daDVTarih">Damga V. Tarihi</label>
                <div><input type="date" id="daDVTarih" class="form-control input-sm th-tarih" data-alan="damgaVergisiTarihi" /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="daDVNo">Damga V. No</label>
                <div><input type="text" id="daDVNo" class="form-control input-sm th-orta" data-alan="damgaVergisiNo" /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="daDVTutar">Damga V. Tutarı</label>
                <div><input type="text" id="daDVTutar" class="form-control input-sm th-tutar" inputmode="decimal" data-alan="damgaVergisiTutari" /></div>
            </div>
        </form>
    </div>
    <div class="pencere-alt">
        <button type="button" class="btn btn-default btn-sm" data-kapat>Kapat</button>
        <button type="button" id="btnDAKaydet" class="btn btn-primary btn-sm"><span class="glyphicon glyphicon-ok" aria-hidden="true"></span> Kaydet</button>
    </div>
</dialog>

