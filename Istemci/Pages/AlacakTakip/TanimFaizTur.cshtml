@page
@model TanimFaizTurModel
@{
    ViewData["Title"] = "Faiz Türü Tanımlama";
    ViewData["GovdeSinif"] = "tanim-sayfa";
}
@if (!Model.Yetkili)
{
    <div class="alert alert-warning" role="alert">Bu sayfayı kullanma yetkiniz yok.</div>
    return;
}

<div class="tanim liste-genis atm-tanim">
    <section class="tanim-sol">
        <div class="kutu">
            <h2 class="kutu-baslik">Faiz Türleri</h2>
            <div class="atm-liste-arama">
                <label class="control-label" for="txtSuz">Ara</label>
                <input type="search" id="txtSuz" class="form-control input-sm" placeholder="Kod (yıl-kod), faiz türü ya da oran" />
            </div>
            <div id="grdFaizTur" class="tanim-grid" aria-label="Faiz türleri"></div>
        </div>
    </section>

    <section>
        <div class="kutu">
            <h2 class="kutu-baslik">Faiz Türü</h2>
            <form id="frmFaizTur" class="tanim-form" novalidate>
                <input type="hidden" id="hdnYil" />
                <input type="hidden" id="hdnKod" />
                <div class="form-group">
                    <label class="control-label" for="txtYilKod">Kod (Yıl-Kod)</label>
                    <div><input type="text" id="txtYilKod" class="form-control dar atm-okuma" readonly /></div>
                </div>
                <div class="form-group">
                    <label class="control-label" for="txtAd">Faiz Türü</label>
                    <div><input type="text" id="txtAd" class="form-control" maxlength="200" /></div>
                </div>
                <div class="form-group">
                    <label class="control-label" for="txtOran">Oran</label>
                    <div><input type="number" id="txtOran" class="form-control dar" step="0.01" /></div>
                </div>
                <div class="form-group">
                    <span class="control-label"></span>
                    <div class="atm-tuslar">
                        <button type="button" id="btnYeni" class="btn btn-default btn-sm" title="İçinde bulunulan yıl için yeni faiz türü">
                            <span class="glyphicon glyphicon-plus" aria-hidden="true"></span> Yeni
                        </button>
                        <button type="submit" id="btnKaydet" class="btn btn-primary btn-sm">
                            <span class="glyphicon glyphicon-floppy-disk" aria-hidden="true"></span> Kaydet
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </section>
</div>

@section Baslik {
    <link rel="stylesheet" href="~/css/tanim.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/atmtanim.css" asp-append-version="true" />
}
@section Betikler {
    <script src="~/lib/ag-grid/ag-grid-community.min.js"></script>
    <script src="~/js/faiztur.js" asp-append-version="true"></script>
}
