@page
@model AlacakTakipListeABModel
@{
    ViewData["Title"] = "Takip İşlemleri";
    // Geniş ekranda sayfa pencereye sığar; tablolar kalan yüksekliği doldurur (atmab.css).
    ViewData["GovdeSinif"] = "atmab-sayfa";
}
@if (!Model.Yetkili)
{
    <div class="alert alert-warning" role="alert">Bu sayfayı kullanma yetkiniz yok.</div>
    return;
}

<div class="atmab">
    <!-- Araç çubuğu (eski liste ve dosya araç çubukları) -->
    <div class="btn-toolbar ab-arac" role="toolbar" aria-label="İşlemler">
        <button type="button" id="btnListele" class="btn btn-primary btn-sm">
            <span class="glyphicon glyphicon-search" aria-hidden="true"></span> Listele
        </button>
        <button type="button" id="btnListeleBek" class="btn btn-default btn-sm" title="Onay bekleyen işlemi olan dosyaları listeler">
            <span class="glyphicon glyphicon-hourglass" aria-hidden="true"></span> Listele (Bek.)
        </button>
        <div class="btn-group btn-group-sm">
            <button type="button" class="btn btn-default dropdown-toggle" aria-haspopup="true" aria-expanded="false">
                <span class="glyphicon glyphicon-print" aria-hidden="true"></span> Liste Yazdır <span class="caret"></span>
            </button>
            <ul class="dropdown-menu">
                <li><a href="#" data-yazdir="3">6305 Borçlu Defteri (TL)</a></li>
                <li><a href="#" data-yazdir="4">6305 Borçlu Defteri (EUR)</a></li>
                <li><a href="#" data-yazdir="5">6305 Borçlu Defteri Yeni (TL)</a></li>
                <li><a href="#" data-yazdir="6">6305 Borçlu Defteri Yeni (EUR)</a></li>
                <li><a href="#" data-yazdir="8">Faiz İşlemleri</a></li>
                <li role="separator" class="divider"></li>
                <li><a href="#" data-sakla="3">Sakla: 6305 Borçlu Defteri (TL)</a></li>
                <li><a href="#" data-sakla="4">Sakla: 6305 Borçlu Defteri (EUR)</a></li>
                <li><a href="#" data-sakla="5">Sakla: 6305 Borçlu Defteri Yeni (TL)</a></li>
                <li><a href="#" data-sakla="6">Sakla: 6305 Borçlu Defteri Yeni (EUR)</a></li>
            </ul>
        </div>
        <div class="btn-group btn-group-sm">
            <button type="button" class="btn btn-default dropdown-toggle" aria-haspopup="true" aria-expanded="false"
                    title="Kriter alanında belirtilen İşlem Tarihine göre dönem ya da yıl mutabakat raporları alınır.">
                <span class="glyphicon glyphicon-list-alt" aria-hidden="true"></span> Mut. Raporları <span class="caret"></span>
            </button>
            <ul class="dropdown-menu">
                <li><a href="#" data-yazdir="18">Dönem Hareketleri</a></li>
                <li><a href="#" data-yazdir="11">6403 Reconciliation Form D-1</a></li>
                <li><a href="#" data-yazdir="12">6404 Reconciliation of D-2 to D-1</a></li>
                <li><a href="#" data-yazdir="13">6405 Borçlu Defteri ile TKDK Mutabakatı</a></li>
                <li><a href="#" data-yazdir="14">6406 Borçlu Defteri ile Borç Kaydı</a></li>
                <li><a href="#" data-yazdir="15">6804 Summary Report on Recoveries</a></li>
                <li><a href="#" data-yazdir="19">Dept Report (TL)</a></li>
                <li><a href="#" data-yazdir="20">Dept Table (EUR)</a></li>
            </ul>
        </div>
        <button type="button" id="btnDonemFaizi" class="btn btn-default btn-sm">
            <span class="glyphicon glyphicon-calendar" aria-hidden="true"></span> Dönem Faizi
        </button>

        <span class="ab-ayrac" aria-hidden="true"></span>

        <button type="button" id="btnYeniDosya" class="btn btn-default btn-sm">
            <span class="glyphicon glyphicon-file" aria-hidden="true"></span> Yeni Dosya
        </button>
        <div class="btn-group btn-group-sm">
            <button type="button" id="btnYeniIslem" class="btn btn-default dropdown-toggle" aria-haspopup="true" aria-expanded="false" disabled>
                <span class="glyphicon glyphicon-plus" aria-hidden="true"></span> Yeni İşlem <span class="caret"></span>
            </button>
            <ul class="dropdown-menu">
                <li><a href="#" data-yeni-islem="51">Ödeme</a></li>
                <li><a href="#" data-yeni-islem="54">Mahsup</a></li>
                <li><a href="#" data-yeni-islem="102">Düzeltme</a></li>
                <li><a href="#" data-yeni-islem="59">Terkin</a></li>
                <li><a href="#" data-yeni-islem="151">Silme</a></li>
                <li><a href="#" data-yeni-islem="152">Fazla Öd. Akt.</a></li>
                <li><a href="#" data-yeni-islem="1">Faiz İşlemi</a></li>
            </ul>
        </div>
        <div class="btn-group btn-group-sm">
            <button type="button" id="btnRaporlar" class="btn btn-default dropdown-toggle" aria-haspopup="true" aria-expanded="false" disabled>
                <span class="glyphicon glyphicon-print" aria-hidden="true"></span> Raporlar <span class="caret"></span>
            </button>
            <ul class="dropdown-menu">
                <li><a href="#" data-rapor="1" data-tur="1">6307 Faiz Hes. Tab.</a></li>
                <li><a href="#" data-rapor="1" data-tur="2">6307 Faiz Hes. Tab. (PDF)</a></li>
                <li><a href="#" data-rapor="7" data-tur="1">6310 Geri Alınması Gereken Tutarlar</a></li>
                <li><a href="#" data-rapor="7" data-tur="2">6310 Geri Alınması Gereken Tutarlar (PDF)</a></li>
                <li><a href="#" data-rapor="10" data-tur="1">6807 Debt and Recovery Report</a></li>
                <li><a href="#" data-rapor="9" data-tur="1" data-pb="1">Silinecek Tutarların Bildirimi (TL)</a></li>
                <li><a href="#" data-rapor="9" data-tur="1" data-pb="2">Silinecek Tutarların Bildirimi (EUR)</a></li>
                <li><a href="#" data-rapor="16" data-tur="1">6805 Overpayment</a></li>
                <li><a href="#" data-rapor="21" data-tur="1">Yeniden Hesapla</a></li>
            </ul>
        </div>
        <label class="ab-arac-tarih" for="txtIslemTarih">İşl. Tarih:
            <input type="date" id="txtIslemTarih" class="form-control input-sm" title="Dosya bilgileri bu tarihe göre hesaplanır (boşsa bugün)" />
        </label>
        <label class="ab-arac-tarih" for="txtOnayTarih">Onay Tarih:
            <input type="date" id="txtOnayTarih" class="form-control input-sm" title="Bu tarihe kadar onaylanmış bilgiler kullanılır (boşsa bugün)" />
        </label>
        <button type="button" id="btnImzalar" class="btn btn-default btn-sm">
            <span class="glyphicon glyphicon-pencil" aria-hidden="true"></span> İmzalar
        </button>
    </div>

    <div class="ab-govde">
        <!-- Sorgu (eski PropertyGrid1) -->
        <section class="kutu bolum bolum-sorgu">
            <h2 class="bolum-baslik">Sorgu Alanları</h2>
            <form id="frmSorgu" class="tanim-form ab-alanlar ab-sorgu" novalidate>
                <div class="form-group">
                    <label class="control-label" for="sIpard">IPARD</label>
                    <div><select id="sIpard" class="form-control input-sm"></select></div>
                </div>
                <div class="form-group">
                    <span class="control-label">Durum</span>
                    <div id="sDurum" class="ab-coklu" data-bos="Hepsi" aria-label="Süreç durumu"></div>
                </div>
                <div class="form-group">
                    <span class="control-label">Muhasebe / Birimi</span>
                    <div id="sMuhBirim"></div>
                </div>
                <div class="form-group">
                    <label class="control-label" for="sArama">Vergi/Ad/Başv. No</label>
                    <div><input type="text" id="sArama" class="form-control input-sm" autocomplete="off" /></div>
                </div>
                <div class="form-group">
                    <span class="control-label">Borç Türü</span>
                    <div id="sBorcTuru" class="ab-coklu" data-bos="Hepsi" aria-label="Borç türü"></div>
                </div>
                <div class="form-group">
                    <label class="control-label" for="sBorcDurumu">Borç Durumu</label>
                    <div>
                        <select id="sBorcDurumu" class="form-control input-sm">
                            <option value="0">Hepsi</option>
                            <option value="1">Borçlular</option>
                            <option value="2">Borçlu (G.A. Var)</option>
                            <option value="3">Borçlu (G.A. Yok)</option>
                            <option value="4">Kapatmışlar</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label class="control-label" for="sAvans">Avans</label>
                    <div><input type="checkbox" id="sAvans" class="ab-kutu" /></div>
                </div>
                <div class="form-group">
                    <label class="control-label" for="sTarihTur">Tarih Tür.</label>
                    <div>
                        <select id="sTarihTur" class="form-control input-sm">
                            <option value="">Tüm İşlemler</option>
                            <option value="geriAlim">Geri Alım</option>
                            <option value="silme">Silme</option>
                            <option value="onBorc">Ön Borç</option>
                            <option value="geriAlimK">Geri Alım K.</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label class="control-label" for="sIslTarih">Tarih Baş. / Bit.</label>
                    <div class="ab-bitisik">
                        <input type="date" id="sIslTarih" class="form-control input-sm ab-tarih" aria-label="Tarih başlangıç" />
                        <span aria-hidden="true">-</span>
                        <input type="date" id="sIslTarihSon" class="form-control input-sm ab-tarih" aria-label="Tarih bitiş" />
                    </div>
                </div>
                <button type="submit" class="sr-only">Listele</button>
            </form>
        </section>

        <!-- Dosyalar (eski grdListe) -->
        <section class="kutu bolum bolum-liste">
            <h2 class="bolum-baslik">Dosyalar <span id="lblSayi" class="ab-sayi"></span></h2>
            <div id="grdListe" class="ab-grid" aria-label="AB alacak takip dosyaları"></div>
        </section>

        <!-- Dosya bilgileri (eski orta sekmeler) -->
        <section class="kutu bolum bolum-dosya">
            <h2 class="bolum-baslik">Dosya Bilgileri <span id="lblDosya" class="ab-sayi"></span></h2>
            <div class="ab-sekme-basliklar" role="tablist" aria-label="Dosya bilgileri">
                <button type="button" role="tab" class="ab-sekme-tus active" data-sekme="borclu" aria-selected="true">Borçlu Kimlik Bilgileri</button>
                <button type="button" role="tab" class="ab-sekme-tus" data-sekme="onborc" aria-selected="false">Ön Borç Bilgileri</button>
                <button type="button" role="tab" class="ab-sekme-tus" data-sekme="gak" aria-selected="false">Geri Alım Kararı</button>
                <button type="button" role="tab" class="ab-sekme-tus" data-sekme="geriodeme" aria-selected="false">Geri Ödeme İşlemleri</button>
                <button type="button" role="tab" class="ab-sekme-tus" data-sekme="durum" aria-selected="false">Yorum/Süreç Durum</button>
                <button type="button" role="tab" class="ab-sekme-tus" data-sekme="taksit" aria-selected="false">Taksitlendirme</button>
                <button type="button" role="tab" class="ab-sekme-tus" data-sekme="islemler" aria-selected="false">İşlem Listesi ve Onaylama</button>
                <button type="button" role="tab" class="ab-sekme-tus" data-sekme="dosyalar" aria-selected="false">Dosyalar</button>
                <button type="button" role="tab" class="ab-sekme-tus" data-sekme="tarihce" aria-selected="false">Tarihçe</button>
            </div>

            <div class="ab-sekmeler">
                <!-- Borçlu Kimlik Bilgileri -->
                <div class="ab-sekme active" data-sekme="borclu" role="tabpanel">
                    <div class="tanim-form ab-alanlar ab-oku">
                        <div class="form-group"><span class="control-label">IPARD Dönemi</span><div><input class="form-control input-sm okuma ab-orta" readonly data-d="iPARDDonemiAd" /></div></div>
                        <div class="form-group"><span class="control-label">Defter Sırası</span><div><input class="form-control input-sm okuma ab-orta" readonly data-d="defterSirasi" /></div></div>
                        <div class="form-group"><span class="control-label">Tedbir-Alt T.-Bütçe Kalemi</span>
                            <div class="ab-bitisik">
                                <input class="form-control input-sm okuma ab-kisa" readonly data-d="tedbir" aria-label="Tedbir" />
                                <input class="form-control input-sm okuma ab-kisa" readonly data-d="altTedbir" aria-label="Alt tedbir" />
                                <input class="form-control input-sm okuma ab-kisa" readonly data-d="butceKalemi" aria-label="Bütçe kalemi" />
                            </div>
                        </div>
                        <div class="form-group"><span class="control-label">İl Koordinatörlüğü</span><div><input class="form-control input-sm okuma" readonly data-d="HrcBirimAd" /></div></div>
                        <div class="form-group"><span class="control-label">Borçlu</span><div><input class="form-control input-sm okuma" readonly data-d="borcluKodAd" /></div></div>
                        <div class="form-group"><span class="control-label">Başvuru Kayıt Numarası</span><div><input class="form-control input-sm okuma" readonly data-d="basvuruKayitNumarasi" /></div></div>
                        <div class="form-group"><span class="control-label">Sözleşme Numarası</span><div><input class="form-control input-sm okuma" readonly data-d="sozlesmeNumarasi" /></div></div>
                    </div>
                    <div class="ab-tablo-arac">
                        <button type="button" class="btn btn-default btn-sm" data-yeni-parca="1" disabled><span class="glyphicon glyphicon-plus" aria-hidden="true"></span> Yeni Borçlu Değişikliği</button>
                    </div>
                    <div id="grdBorcluIslem" class="ab-grid ab-grid-kucuk" aria-label="Borçlu işlemleri"></div>
                </div>

                <!-- Ön Borç Bilgileri -->
                <div class="ab-sekme" data-sekme="onborc" role="tabpanel" hidden>
                    <div class="tanim-form ab-alanlar ab-oku">
                        <div class="form-group"><span class="control-label">Borcun Türü</span><div><input class="form-control input-sm okuma" readonly data-d="borcTuruAd" /></div></div>
                        <div class="form-group"><span class="control-label">Borcun Kodu</span><div><input class="form-control input-sm okuma" readonly data-d="borcunKoduAd" /></div></div>
                        <div class="form-group"><span class="control-label">Vaka Numarası</span>
                            <div class="ab-bitisik">
                                <input class="form-control input-sm okuma ab-orta" readonly data-d="vakaNumarasi" aria-label="Vaka numarası" />
                                <label class="ab-yan"><input type="checkbox" disabled data-d="avans" /> Avans</label>
                            </div>
                        </div>
                        <div class="form-group"><span class="control-label">Ön Borç Tarih - Sayı</span>
                            <div class="ab-bitisik">
                                <input class="form-control input-sm okuma ab-tarih" readonly data-d="onBorcTarihi" data-bicim="tarih" aria-label="Ön borç tarihi" />
                                <input class="form-control input-sm okuma ab-orta" readonly data-d="onBorcSayi" aria-label="Ön borç sayı" />
                            </div>
                        </div>
                        <div class="form-group"><span class="control-label">Öng. Silinme Tarihi</span>
                            <div class="ab-bitisik">
                                <input class="form-control input-sm okuma ab-tarih" readonly data-d="ongorulenSilinmeTarihi" data-bicim="tarih" aria-label="Öngörülen silinme tarihi" />
                                <span class="ab-fazla-odeme" hidden>Aktarım Tarihi:</span>
                                <input class="form-control input-sm okuma ab-tarih ab-fazla-odeme" readonly data-d="ipardAktarimTar" data-bicim="tarih" aria-label="Aktarım tarihi" hidden />
                            </div>
                        </div>
                        <div class="form-group"><span class="control-label">Kur</span><div><input class="form-control input-sm okuma ab-kisa ab-tutar" readonly data-d="onBorcDovizKuru" data-bicim="kur" /></div></div>
                        <div class="form-group ab-uclu-baslik"><span class="control-label"></span><div class="ab-uclu"><span>AB</span><span>Ulusal</span><span>Toplam</span></div></div>
                        <div class="form-group"><span class="control-label">Ön Borç Miktarı (TL)</span>
                            <div class="ab-uclu">
                                <input class="form-control input-sm okuma ab-tutar" readonly data-d="onBorcMiktarAB" data-bicim="tutar" aria-label="AB" />
                                <input class="form-control input-sm okuma ab-tutar" readonly data-d="onBorcMiktarUlusal" data-bicim="tutar" aria-label="Ulusal" />
                                <input class="form-control input-sm okuma ab-tutar" readonly data-d="onBorcToplam" data-bicim="tutar" aria-label="Toplam" />
                            </div>
                        </div>
                        <div class="form-group"><span class="control-label">Ön Borç Miktarı (EUR)</span>
                            <div class="ab-uclu">
                                <input class="form-control input-sm okuma ab-tutar" readonly data-d="onBorcMiktarABEUR" data-bicim="tutar" aria-label="AB" />
                                <input class="form-control input-sm okuma ab-tutar" readonly data-d="onBorcMiktarUlusalEUR" data-bicim="tutar" aria-label="Ulusal" />
                                <input class="form-control input-sm okuma ab-tutar" readonly data-d="onBorcToplamEUR" data-bicim="tutar" aria-label="Toplam" />
                            </div>
                        </div>
                    </div>
                    <div class="ab-tablo-arac">
                        <button type="button" class="btn btn-default btn-sm" data-yeni-parca="2" disabled><span class="glyphicon glyphicon-plus" aria-hidden="true"></span> Yeni Ön Borç Değişikliği/İptali</button>
                    </div>
                    <div id="grdOnBorcIslem" class="ab-grid ab-grid-kucuk" aria-label="Ön borç işlemleri"></div>
                </div>

                <!-- Geri Alım Kararı -->
                <div class="ab-sekme" data-sekme="gak" role="tabpanel" hidden>
                    <div class="tanim-form ab-alanlar ab-oku">
                        <div class="form-group"><span class="control-label">G.A.K. Tarihi</span>
                            <div class="ab-bitisik">
                                <input class="form-control input-sm okuma ab-tarih" readonly data-d="geriAlimKarariTarihi" data-bicim="tarih" aria-label="Geri alım kararı tarihi" />
                                <span>Dönem:</span>
                                <input class="form-control input-sm okuma ab-kisa" readonly data-d="donemYil" aria-label="Dönem yılı" />
                                <span aria-hidden="true">-</span>
                                <input class="form-control input-sm okuma ab-mini" readonly data-d="donemCeyrek" aria-label="Dönem çeyreği" />
                            </div>
                        </div>
                        <div class="form-group"><span class="control-label">Sayı</span>
                            <div class="ab-bitisik">
                                <input class="form-control input-sm okuma ab-orta" readonly data-d="geriAlimSayi" aria-label="Geri alım sayısı" />
                                <span>Kur:</span>
                                <input class="form-control input-sm okuma ab-kisa ab-tutar" readonly data-d="geriAlimDovizKuru" data-bicim="kur" aria-label="Kur" />
                            </div>
                        </div>
                        <div class="form-group"><span class="control-label">Bildirim Tarihi</span>
                            <div class="ab-bitisik">
                                <input class="form-control input-sm okuma ab-tarih" readonly data-d="bildirimTarihi" data-bicim="tarih" aria-label="Bildirim tarihi" />
                                <span>Mektup Alınma Tar.:</span>
                                <input class="form-control input-sm okuma ab-tarih" readonly data-d="tesellumTarihi" data-bicim="tarih" aria-label="Mektup alınma tarihi" />
                            </div>
                        </div>
                        <div class="form-group"><span class="control-label">Ödeme Son Tarihi</span>
                            <div class="ab-bitisik">
                                <input class="form-control input-sm okuma ab-tarih" readonly data-d="odemeSonTarihi" data-bicim="tarih" aria-label="Ödeme son tarihi" />
                                <span>Temerrüt Tarihi:</span>
                                <input class="form-control input-sm okuma ab-tarih" readonly data-d="temerrutTarihi" data-bicim="tarih" aria-label="Temerrüt tarihi" />
                            </div>
                        </div>
                        <div class="form-group"><span class="control-label">Faiz Hesabı Son Tarihi</span>
                            <div class="ab-bitisik">
                                <input class="form-control input-sm okuma ab-tarih" readonly data-d="faizHesabiSonTarihi" data-bicim="tarih" aria-label="Faiz hesabı son tarihi" />
                                <span>Faizin Dur. Tarihi:</span>
                                <input class="form-control input-sm okuma ab-tarih" readonly data-d="faizinDurdurulmaTarihi" data-bicim="tarih" aria-label="Faizin durdurulma tarihi" />
                            </div>
                        </div>
                        <div class="form-group ab-uclu-baslik"><span class="control-label"></span><div class="ab-uclu"><span>AB</span><span>Ulusal</span><span>Toplam</span></div></div>
                        <div class="form-group"><span class="control-label">Geri A.K. Miktar (TL)</span>
                            <div class="ab-uclu">
                                <input class="form-control input-sm okuma ab-tutar" readonly data-d="geriAlimMiktarAB" data-bicim="tutar" aria-label="AB" />
                                <input class="form-control input-sm okuma ab-tutar" readonly data-d="geriAlimMiktarUlusal" data-bicim="tutar" aria-label="Ulusal" />
                                <input class="form-control input-sm okuma ab-tutar" readonly data-d="geriAlimMiktarToplam" data-bicim="tutar" aria-label="Toplam" />
                            </div>
                        </div>
                        <div class="form-group"><span class="control-label">Geri A.K. Miktar (EUR)</span>
                            <div class="ab-uclu">
                                <input class="form-control input-sm okuma ab-tutar" readonly data-d="geriAlimMiktarABEUR" data-bicim="tutar" aria-label="AB" />
                                <input class="form-control input-sm okuma ab-tutar" readonly data-d="geriAlimMiktarUlusalEUR" data-bicim="tutar" aria-label="Ulusal" />
                                <input class="form-control input-sm okuma ab-tutar" readonly data-d="geriAlimMiktarToplamEUR" data-bicim="tutar" aria-label="Toplam" />
                            </div>
                        </div>
                        <div class="form-group"><span class="control-label">Silinmeyecek Miktar</span>
                            <div class="ab-bitisik">
                                <input class="form-control input-sm okuma ab-orta ab-tutar" readonly data-d="silinmeyecekMiktar" data-bicim="tutar" aria-label="Silinmeyecek miktar (TL)" />
                                <span>TL</span>
                                <input class="form-control input-sm okuma ab-orta ab-tutar" readonly data-d="silinmeyecekMiktarEUR" data-bicim="tutar" aria-label="Silinmeyecek miktar (EUR)" />
                                <span>EUR</span>
                            </div>
                        </div>
