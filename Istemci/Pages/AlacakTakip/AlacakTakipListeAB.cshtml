                    <input type="text" class="form-control input-sm ab-orta ab-tutar ab-kaldirilir" data-p="silinmeyecekMiktar" data-bicim="tutar" inputmode="decimal" aria-label="Silinmeyecek ceza tutarı (TL)" />
                    <span>TL</span>
                    <input type="text" class="form-control input-sm okuma ab-orta ab-tutar" readonly data-p="silinmeyecekMiktarEUR" data-bicim="tutar" data-salt aria-label="Silinmeyecek ceza tutarı (EUR)" />
                    <span>EUR</span>
                </div>
            </div>
            <div class="form-group ust-hizali">
                <label class="control-label" for="g_gerekce">Gerekçe (*)</label>
                <div><textarea id="g_gerekce" class="form-control input-sm" rows="2" data-p="gerekce"></textarea></div>
            </div>
            <div class="ab-parca-alt"></div>
        </form>
    </div>
    <div class="pencere-alt">
        <button type="button" class="btn btn-success btn-sm ab-yeni-tus" data-islem="1" data-onay="Geri alım kararı bilgileri kaydedilecek. Onaylıyor musunuz?"><span class="glyphicon glyphicon-floppy-disk" aria-hidden="true"></span> Kaydet</button>
        <button type="button" class="btn btn-primary btn-sm ab-yeni-tus" data-islem="5" data-onay="Geri alım kararı bilgileri onaylanacak ve bu tarihten sonra aktif olacak. Onaylıyor musunuz?"><span class="glyphicon glyphicon-ok" aria-hidden="true"></span> Onayla</button>
        <button type="button" class="btn btn-danger btn-sm ab-yeni-tus" data-islem="9" data-onay="Geri alım kararı bilgileri iptal edilecek. Onaylıyor musunuz?"><span class="glyphicon glyphicon-remove" aria-hidden="true"></span> İptal Et</button>
        <button type="button" class="btn btn-default btn-sm ab-yeniyap-tus" data-islem="6" data-onay="Geri Alım Kararı bilgisi veri düzenlemeye açılacak. Onaylıyor musunuz?"><span class="glyphicon glyphicon-repeat" aria-hidden="true"></span> Yeni Yap</button>
        <button type="button" class="btn btn-warning btn-sm ab-guncelle-tus" data-islem="2" data-onay="G.A. Kararı bilgisindeki yıldız işaretli alanlar güncellenecektir. Onaylıyor musunuz?"><span class="glyphicon glyphicon-edit" aria-hidden="true"></span> Güncelle</button>
        <button type="button" class="btn btn-default btn-sm" data-kapat>Kapat</button>
    </div>
</dialog>

<!-- ================================================================ Süreç Durumu Girişi (eski wndDurumGiris) -->
<dialog id="dlgDurum" class="tanim-pencere ab-pencere" aria-labelledby="dlgDurumBaslik">
    <div class="pencere-baslik">
        <h2 id="dlgDurumBaslik">Süreç Durumu Girişi</h2>
        <button type="button" class="close" data-kapat aria-label="Kapat"><span aria-hidden="true">&times;</span></button>
    </div>
    <div class="pencere-govde">
        <form class="tanim-form ab-alanlar" novalidate>
            <input type="hidden" data-p="ipardDonemi" /><input type="hidden" data-p="dosyaAnahtar" /><input type="hidden" data-p="sira" />
            <div class="form-group">
                <label class="control-label" for="du_surec">Süreç Durum</label>
                <div><select id="du_surec" class="form-control input-sm" data-p="surecAsamasi"></select></div>
            </div>
            <div class="form-group ust-hizali">
                <label class="control-label" for="du_yorum">Yorumlar (TR)</label>
                <div><textarea id="du_yorum" class="form-control input-sm" rows="8" data-p="yorumlarTR"></textarea></div>
            </div>
            <div class="form-group ust-hizali">
                <label class="control-label" for="du_gerekce">Gerekçe</label>
                <div><textarea id="du_gerekce" class="form-control input-sm" rows="2" data-p="gerekce"></textarea></div>
            </div>
            <div class="ab-parca-alt"></div>
        </form>
    </div>
    <div class="pencere-alt">
        <button type="button" class="btn btn-success btn-sm ab-yeni-tus" data-islem="1" data-onay="Süreç durum bilgisi kaydedilecek. Onaylıyor musunuz?"><span class="glyphicon glyphicon-floppy-disk" aria-hidden="true"></span> Kaydet</button>
        <button type="button" class="btn btn-primary btn-sm ab-yeni-tus" data-islem="5" data-onay="Süreç durum bilgisi onaylanacak ve bu tarihten sonra aktif olacak. Onaylıyor musunuz?"><span class="glyphicon glyphicon-ok" aria-hidden="true"></span> Onayla</button>
        <button type="button" class="btn btn-danger btn-sm ab-yeni-tus" data-islem="9" data-onay="Süreç durum bilgisi iptal edilecek. Onaylıyor musunuz?"><span class="glyphicon glyphicon-remove" aria-hidden="true"></span> İptal Et</button>
        <button type="button" class="btn btn-default btn-sm ab-yeniyap-tus" data-islem="6" data-onay="Durum bilgisi veri düzenlemeye açılacak. Onaylıyor musunuz?"><span class="glyphicon glyphicon-repeat" aria-hidden="true"></span> Yeni Yap</button>
        <button type="button" class="btn btn-default btn-sm" data-kapat>Kapat</button>
    </div>
</dialog>

<!-- ================================================================ Taksit Girişi/İptali (eski wndTaksitGiris) -->
<dialog id="dlgTaksit" class="tanim-pencere ab-pencere ab-pencere-genis" aria-labelledby="dlgTaksitBaslik">
    <div class="pencere-baslik">
        <h2 id="dlgTaksitBaslik">Taksit Girişi/İptali</h2>
        <button type="button" class="close" data-kapat aria-label="Kapat"><span aria-hidden="true">&times;</span></button>
    </div>
    <div class="pencere-govde">
        <form class="tanim-form ab-alanlar" novalidate>
            <input type="hidden" data-p="ipardDonemi" /><input type="hidden" data-p="dosyaAnahtar" /><input type="hidden" data-p="sira" />
            <div class="form-group">
                <span class="control-label">İşlem</span>
                <div><label class="ab-yan"><input type="checkbox" class="ab-kaldirma" data-p="kaldirma" data-taksit /> Mevcut Taksitin Kaldırılması</label></div>
            </div>
            <div class="form-group"><span class="control-label">Toplam Ana Para/Faiz</span>
                <div class="ab-bitisik">
                    <input type="text" id="t_anaPara" class="form-control input-sm okuma ab-orta ab-tutar" readonly aria-label="Toplam ana para" />
                    <input type="text" id="t_faiz" class="form-control input-sm okuma ab-orta ab-tutar" readonly aria-label="Toplam faiz" />
                </div>
            </div>
            <div class="form-group">
                <label class="control-label" for="t_ilk">İlk Ödeme Tarihi/ Taksit Sayısı</label>
                <div class="ab-bitisik">
                    <input type="date" id="t_ilk" class="form-control input-sm ab-tarih ab-kaldirilir" data-p="taksitIlkTarih" data-taksit />
                    <input type="number" class="form-control input-sm ab-kisa ab-kaldirilir" data-p="taksitSayisi" min="0" max="1000" step="1" data-taksit aria-label="Taksit sayısı" />
                </div>
            </div>
            <div class="form-group">
                <label class="control-label" for="t_tur">Taksit Tür</label>
                <div>
                    <select id="t_tur" class="form-control input-sm ab-orta" data-p="tecilFaizNo" data-taksit>
                        <option value="-1">Seçiniz</option>
                        <option value="0">Tecil Faizi</option>
                        <option value="1">Tüzel Tecil Faizi</option>
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label class="control-label" for="t_giris">Giriş Tarihi</label>
                <div><input type="date" id="t_giris" class="form-control input-sm ab-tarih" data-p="girisTarihi" data-taksit /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="t_talep">Talep Tarih/Sayı</label>
                <div class="ab-bitisik">
                    <input type="date" id="t_talep" class="form-control input-sm ab-tarih" data-p="taksitTalepTarihi" data-taksit />
                    <input type="text" class="form-control input-sm ab-orta" data-p="taksitTalepSayi" aria-label="Talep sayı" autocomplete="off" />
                </div>
            </div>
            <div class="form-group">
                <label class="control-label" for="t_karar">Karar Tarih/Sayı</label>
                <div class="ab-bitisik">
                    <input type="date" id="t_karar" class="form-control input-sm ab-tarih" data-p="taksitKararTarihi" />
                    <input type="text" class="form-control input-sm ab-orta" data-p="taksitKararSayi" aria-label="Karar sayı" autocomplete="off" />
                </div>
            </div>
            <div class="ab-tablo-arac">
                <strong>Taksit Listesi</strong>
                <button type="button" id="t_yazdir" class="btn btn-default btn-sm"><span class="glyphicon glyphicon-print" aria-hidden="true"></span> Yazdır</button>
            </div>
            <div id="grdTaksitOnizleme" class="ab-grid ab-grid-kucuk ab-kaldirilir-grid" aria-label="Taksit listesi"></div>
            <div class="form-group ust-hizali">
                <label class="control-label" for="t_gerekce">Gerekçe</label>
                <div><textarea id="t_gerekce" class="form-control input-sm" rows="2" data-p="gerekce"></textarea></div>
            </div>
            <div class="ab-parca-alt"></div>
        </form>
    </div>
    <div class="pencere-alt">
        <button type="button" class="btn btn-success btn-sm ab-yeni-tus" data-islem="1" data-onay="Taksit işlem bilgisi kaydedilecek. Onaylıyor musunuz?"><span class="glyphicon glyphicon-floppy-disk" aria-hidden="true"></span> Kaydet</button>
        <button type="button" class="btn btn-primary btn-sm ab-yeni-tus" data-islem="5" data-onay="Taksit işlem bilgisi onaylanacak ve bu tarihten sonra aktif olacak. Onaylıyor musunuz?"><span class="glyphicon glyphicon-ok" aria-hidden="true"></span> Onayla</button>
        <button type="button" class="btn btn-danger btn-sm ab-yeni-tus" data-islem="9" data-onay="Taksit işlem bilgisi iptal edilecek. Onaylıyor musunuz?"><span class="glyphicon glyphicon-remove" aria-hidden="true"></span> İptal Et</button>
        <button type="button" class="btn btn-default btn-sm ab-yeniyap-tus" data-islem="6" data-onay="Taksit işlem bilgisi veri düzenlemeye açılacak. Onaylıyor musunuz?"><span class="glyphicon glyphicon-repeat" aria-hidden="true"></span> Yeni Yap</button>
        <button type="button" class="btn btn-default btn-sm" data-kapat>Kapat</button>
    </div>
</dialog>

<!-- ================================================================ İmzalar (eski wndImzalar) -->
<dialog id="dlgImza" class="tanim-pencere ab-pencere" aria-labelledby="dlgImzaBaslik">
    <div class="pencere-baslik">
        <h2 id="dlgImzaBaslik">İmzalar</h2>
        <button type="button" class="close" data-kapat aria-label="Kapat"><span aria-hidden="true">&times;</span></button>
    </div>
    <div class="pencere-govde">
        <form class="tanim-form ab-alanlar" novalidate>
            <div class="form-group ab-uclu-baslik"><span class="control-label"></span><div class="ab-ikili"><span>Ad Soyad</span><span>Unvan</span></div></div>
            <div class="form-group"><label class="control-label" for="i_hazirlayan">Hazırlayan</label>
                <div class="ab-ikili"><input type="text" id="i_hazirlayan" class="form-control input-sm" data-p="hazirlayan" /><input type="text" class="form-control input-sm" data-p="hazirlayanUnv" aria-label="Hazırlayan unvanı" /></div></div>
            <div class="form-group"><label class="control-label" for="i_kontrolEden">Kontrol Eden</label>
                <div class="ab-ikili"><input type="text" id="i_kontrolEden" class="form-control input-sm" data-p="kontrolEden" /><input type="text" class="form-control input-sm" data-p="kontrolEdenUnv" aria-label="Kontrol eden unvanı" /></div></div>
            <div class="form-group"><label class="control-label" for="i_gozdenGeciren">Gözden Geçiren</label>
                <div class="ab-ikili"><input type="text" id="i_gozdenGeciren" class="form-control input-sm" data-p="gozdenGeciren" /><input type="text" class="form-control input-sm" data-p="gozdenGecirenUnv" aria-label="Gözden geçiren unvanı" /></div></div>
            <div class="form-group"><label class="control-label" for="i_onaylayan">Onaylayan</label>
                <div class="ab-ikili"><input type="text" id="i_onaylayan" class="form-control input-sm" data-p="onaylayan" /><input type="text" class="form-control input-sm" data-p="onaylayanUnv" aria-label="Onaylayan unvanı" /></div></div>
            <div class="form-group"><label class="control-label" for="i_uygunBulan">Uygun Bulan</label>
                <div class="ab-ikili"><input type="text" id="i_uygunBulan" class="form-control input-sm" data-p="uygunBulan" /><input type="text" class="form-control input-sm" data-p="uygunBulanUnv" aria-label="Uygun bulan unvanı" /></div></div>
        </form>
    </div>
    <div class="pencere-alt">
        <button type="button" id="i_kaydet" class="btn btn-success btn-sm"><span class="glyphicon glyphicon-floppy-disk" aria-hidden="true"></span> Kaydet</button>
        <button type="button" class="btn btn-default btn-sm" data-kapat>Kapat</button>
    </div>
</dialog>

<!-- ================================================================ Dönem Faizi (eski wndHesaplat) -->
<dialog id="dlgDonemFaizi" class="tanim-pencere ab-pencere ab-pencere-dar" aria-labelledby="dlgDonemFaiziBaslik">
    <div class="pencere-baslik">
        <h2 id="dlgDonemFaiziBaslik">Dönem Faizi</h2>
        <button type="button" class="close" data-kapat aria-label="Kapat"><span aria-hidden="true">&times;</span></button>
    </div>
    <div class="pencere-govde">
        <form class="tanim-form ab-alanlar" novalidate>
            <div class="form-group">
                <label class="control-label" for="h_yil">Yıl</label>
                <div><input type="number" id="h_yil" class="form-control input-sm sgb-yil ab-kisa" step="1" /></div>
            </div>
            <div class="form-group">
                <label class="control-label" for="h_ay">Ay</label>
                <div>
                    <select id="h_ay" class="form-control input-sm ab-orta">
                        <option value="3">3-Mart</option>
                        <option value="6">6-Haziran</option>
                        <option value="9">9-Eylül</option>
                        <option value="12">12-Aralık</option>
                    </select>
                </div>
            </div>
            <p class="help-block small">Seçilen ayın son günü için işlem yapılır.</p>
        </form>
    </div>
    <div class="pencere-alt">
        <button type="button" class="btn btn-success btn-sm" data-htur="1"><span class="glyphicon glyphicon-cog" aria-hidden="true"></span> Üret</button>
        <button type="button" class="btn btn-primary btn-sm" data-htur="2"><span class="glyphicon glyphicon-ok" aria-hidden="true"></span> Onayla</button>
        <button type="button" class="btn btn-danger btn-sm" data-htur="3"><span class="glyphicon glyphicon-remove" aria-hidden="true"></span> İptal Et</button>
        <button type="button" class="btn btn-default btn-sm" data-kapat>Kapat</button>
    </div>
</dialog>

