@page
@model TanimDurumModel
@{
    ViewData["Title"] = "Durum Tanımlama";
    ViewData["GovdeSinif"] = "tanim-sayfa";
}
@if (!Model.Yetkili)
{
    <div class="alert alert-warning" role="alert">Bu sayfayı kullanma yetkiniz yok.</div>
    return;
}

<div class="tanim atm-tanim">
    <section>
        <div class="kutu">
            <h2 class="kutu-baslik">Durum</h2>
            <form id="frmDurum" class="tanim-form" novalidate>
                <input type="hidden" id="hdnKod" />
                <div class="form-group">
                    <label class="control-label" for="txtAd">Durum Tanımı</label>
                    <div><input type="text" id="txtAd" class="form-control" maxlength="50" /></div>
                </div>
                <div class="form-group">
                    <span class="control-label"></span>
                    <div class="atm-tuslar">
                        <button type="button" id="btnKaydet" class="btn btn-primary btn-sm">
                            <span class="glyphicon glyphicon-floppy-disk" aria-hidden="true"></span> Kaydet
                        </button>
                        <button type="submit" id="btnAra" class="btn btn-default btn-sm" title="Durumları yeniden okur">
                            <span class="glyphicon glyphicon-search" aria-hidden="true"></span> Bul
                        </button>
                        <button type="button" id="btnTemizle" class="btn btn-default btn-sm">
                            <span class="glyphicon glyphicon-erase" aria-hidden="true"></span> Temizle
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </section>

    <section class="tanim-sol">
        <div class="kutu">
            <h2 class="kutu-baslik">Durumlar</h2>
            <div id="grdDurum" class="tanim-grid" aria-label="Durumlar"></div>
        </div>
    </section>
</div>

@section Baslik {
    <link rel="stylesheet" href="~/css/tanim.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/atmtanim.css" asp-append-version="true" />
}
@section Betikler {
    <script src="~/lib/ag-grid/ag-grid-community.min.js"></script>
    <script src="~/js/atmdurum.js" asp-append-version="true"></script>
}
