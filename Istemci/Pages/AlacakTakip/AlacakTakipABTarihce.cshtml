@page
@model AlacakTakipABTarihceModel
@{
    ViewData["Title"] = "Dosya Tarihçesi";
    ViewData["GovdeSinif"] = "tanim-sayfa";
}
@if (!Model.Yetkili)
{
    <div class="alert alert-warning" role="alert">Bu sayfayı kullanma yetkiniz yok.</div>
    return;
}

<div class="tanim atm-tanim tek">
    <section class="tanim-sol">
        <div class="kutu">
            <div class="tanim-arac btn-toolbar" role="toolbar" aria-label="Tarihçe işlemleri">
                <button type="button" id="btnYenile" class="btn btn-default btn-sm">
                    <span class="glyphicon glyphicon-refresh" aria-hidden="true"></span> Yenile
                </button>
            </div>
            <div id="grdTarihce" class="tanim-grid" aria-label="Dosya işlem tarihçesi"></div>
        </div>
    </section>
</div>

@section Baslik {
    <link rel="stylesheet" href="~/css/tanim.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/atmtanim.css" asp-append-version="true" />
}
@section Betikler {
    <script src="~/lib/ag-grid/ag-grid-community.min.js"></script>
    <script src="~/js/atmabtarihce.js" asp-append-version="true"></script>
}
