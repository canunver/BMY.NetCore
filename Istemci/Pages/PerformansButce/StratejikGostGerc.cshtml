@page
@model StratejikGostGercModel
@{
    ViewData["Title"] = "İzleme Tablosu";
    // Geniş ekranda sayfa pencereye sığar, bölmeler kendi içinde kayar (tanim.css, stratejikgostgerc.css).
    ViewData["GovdeSinif"] = "tanim-sayfa";
}
@if (!Model.Yetkili)
{
    <div class="alert alert-warning" role="alert">Bu sayfayı kullanma yetkiniz yok.</div>
    return;
}

<div class="tanim izleme">
    <!-- Sol: arama bölmesi ve hedefler -->
    <section class="tanim-sol">
        <div class="kutu">
            <div class="btn-toolbar tanim-arac" role="toolbar">
                <button type="button" id="btnListele" class="btn btn-primary btn-sm">
                    <span class="glyphicon glyphicon-list" aria-hidden="true"></span> Listele
                </button>
                <!-- Raporlar (eski Raporlar menüsü). İlk ikisi plandaki bütün hedefleri (Word), son ikisi kurumun başarımlarını (Excel) verir. -->
                <span class="btn-group btn-group-sm pull-right" role="group" aria-label="Raporlar">
                    <button type="button" class="btn btn-default" data-rapor="12" title="Bütün hedeflerin izleme / değerlendirme raporu (Word)">
                        <span class="glyphicon glyphicon-print" aria-hidden="true"></span> Rapor
                    </button>
                    <button type="button" class="btn btn-default" data-rapor="11" id="btnRaporV1" title="Bütün hedeflerin raporu, eski biçim (Word)">Rapor (v1)</button>
                    <button type="button" class="btn btn-default" data-kurum-rapor="hedef" title="Kurumun hedef başarımları (Excel)">Hedef Bşrm</button>
                    <button type="button" class="btn btn-default" data-kurum-rapor="gosterge" title="Kurumun gösterge başarımları (Excel)">Göst. Bşrm</button>
                </span>
                <!-- Grafikler (eski Dağılım ve Seyir): seçilen yılın yıl sonu başarımlarına göre -->
                <span class="btn-group btn-group-sm pull-right" role="group" aria-label="Grafikler">
                    <button type="button" class="btn btn-default" data-grafik="sp1" title="Başarı düzeyine göre hedef dağılımı (grafik)">
                        <span class="glyphicon glyphicon-stats" aria-hidden="true"></span> Dağılım
                    </button>
                    <button type="button" class="btn btn-default" data-grafik="sp2" title="Stratejik planın başarı seyri (grafik)">Seyir</button>
                </span>
            </div>

            <form id="frmArama" class="tanim-arama" novalidate>
                <div class="form-group">
                    <label class="control-label" for="ddlKurum">Kurum</label>
                    <div><select id="ddlKurum" class="form-control"></select></div>
                </div>
                <div class="form-group">
                    <label class="control-label" for="ddlPlan">Plan Dönemi</label>
                    <div><select id="ddlPlan" class="form-control"></select></div>
                </div>
                <div class="form-group">
                    <span class="control-label" id="lblDonem">Dönem</span>
                    <div class="arama-satir" role="group" aria-labelledby="lblDonem">
                        <input type="number" id="txtYil" class="form-control" min="2000" max="2100" step="1" aria-label="Gerçekleşme yılı" />
                        <select id="ddlDonem" class="form-control genis" aria-label="İzleme dönemi"></select>
                    </div>
                </div>
            </form>

            <h2 class="kutu-baslik">Hedefler</h2>
            <ul id="lstHedef" class="kayan" aria-label="Hedefler"></ul>
        </div>
    </section>

    <!-- Sağ: seçili hedefin göstergelerinin gerçekleşmeleri -->
    <section class="tanim-sag">
        <div class="kutu">
            <h2 class="kutu-baslik" id="hedefBaslik">Gerçekleşmeler</h2>
            <div class="btn-toolbar tanim-arac" role="toolbar">
                <button type="button" id="btnKaydet" class="btn btn-primary btn-sm" disabled>
                    <span class="glyphicon glyphicon-floppy-disk" aria-hidden="true"></span> Kaydet
                </button>
                <button type="button" class="btn btn-default btn-sm" data-rapor="1" data-hedefli disabled title="Seçili hedefin izleme / değerlendirme raporu (Word)">
                    <span class="glyphicon glyphicon-print" aria-hidden="true"></span> Yazdır
                </button>
                <button type="button" class="btn btn-default btn-sm" data-rapor="2" data-hedefli disabled title="Seçili hedefin raporu, yeni biçim (Word)">
                    <span class="glyphicon glyphicon-print" aria-hidden="true"></span> Yazdır (v2)
                </button>
            </div>

            <div class="kayan">
                <p id="gercBos" class="tanim-not duz">Soldan bir hedef seçiniz.</p>
                <div class="tablo-kaydir">
                    <table class="table table-condensed duzen-tablo" id="tblGerc" hidden>
                        <thead></thead>
                        <tbody></tbody>
                    </table>
                </div>

                <div id="gercBilgi" class="tanim-form" style="--etiket-genislik: 130px" hidden>
                    <div class="form-group ust-hizali">
                        <label class="control-label" for="txtDegerlendirmeler">Değerlendirmeler</label>
                        <div><textarea id="txtDegerlendirmeler" class="form-control" rows="4"></textarea></div>
                    </div>
                    <!-- Sapma nedeni ve alınacak önlem yalnızca yıl sonu değerlendirmesinde girilir -->
                    <div class="form-group ust-hizali" data-degerlendirme>
                        <label class="control-label" for="txtSapmaNedeni">Sapma Nedeni</label>
                        <div><textarea id="txtSapmaNedeni" class="form-control" rows="2"></textarea></div>
                    </div>
                    <div class="form-group ust-hizali" data-degerlendirme>
                        <label class="control-label" for="txtAlinacakOnlem">Alınacak Önlem</label>
                        <div><textarea id="txtAlinacakOnlem" class="form-control" rows="2"></textarea></div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Baslik {
    <link rel="stylesheet" href="~/css/tanim.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/stratejikplan.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/stratejikgostgerc.css" asp-append-version="true" />
}
@section Betikler {
    <script src="~/js/stratejikgostgerc.js" asp-append-version="true"></script>
}
