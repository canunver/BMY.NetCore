@page
@model APGirisModel
@{
    var program = Model.Gelir ? "AGP" : "AHP";
    ViewData["Title"] = Model.Gelir ? "AGP Girişi (Ayrıntılı Gelir Programı)" : "AHP Girişi (Ayrıntılı Harcama Programı)";
}
@if (!Model.Yetkili)
{
    <div class="alert alert-warning" role="alert">Bu sayfayı kullanma yetkiniz yok.</div>
    return;
}

<div class="ap-giris" data-tur="@(Model.Gelir ? "gelir" : "gider")">
    <!-- Sol: kriterler, raporlar, dosya işlemleri (eski soldaki üç panel) -->
    <div class="ap-sol">
        <div class="kutu bolum bolum-secim">
            <h2 class="bolum-baslik">Kriterler</h2>
            <form id="frmSecim" class="tanim-form ap-form" novalidate>
                <div class="form-group">
                    <label class="control-label" for="ddlYil">Yıl</label>
                    <div><input type="number" id="ddlYil" class="form-control input-sm ap-yil sgb-yil" min="2000" max="2100" step="1" /></div>
                </div>
                <div class="form-group">
                    <label class="control-label" for="ddlAsama">Aşama</label>
                    <div><select id="ddlAsama" class="form-control input-sm"></select></div>
                </div>
                @{
                    var alanlar = Model.Gelir
                        ? new[] { new { kod = "1", alan = "kur", ad = "Kurumsal" }, new { kod = "5", alan = "eko", ad = "Gelir Kodu" } }
                        : new[]
                        {
                            new { kod = "1", alan = "kur", ad = "Kurumsal" },
                            new { kod = "2", alan = "fon", ad = "Fonksiyonel" },
                            new { kod = "3", alan = "fin", ad = "Finans" },
                            new { kod = "4", alan = "eko", ad = "Ekonomik" },
                            new { kod = "14", alan = "peb", ad = "Faaliyet" }
                        };
                }
                @foreach (var a in alanlar)
                {
                    <div class="form-group kod-alan" data-kod="@a.kod" data-alan="@a.alan">
                        <label class="control-label" for="txt_@a.alan">@a.ad</label>
                        <div class="input-group input-group-sm">
                            <input type="text" id="txt_@a.alan" class="form-control" autocomplete="off" placeholder="Tümü" title="@a.ad kodu (Alt+Aşağı: kod ağacı)" />
                            <span class="input-group-btn">
                                <button type="button" class="btn btn-default kod-sec" title="Kod ağacından seç"><span class="glyphicon glyphicon-search" aria-hidden="true"></span><span class="sr-only">@a.ad seç</span></button>
                                <button type="button" class="btn btn-default kod-temizle" title="Temizle"><span class="glyphicon glyphicon-remove" aria-hidden="true"></span><span class="sr-only">@a.ad temizle</span></button>
                            </span>
                        </div>
                    </div>
                }
            </form>
        </div>

        <div class="kutu bolum bolum-rapor">
            <h2 class="bolum-baslik">Raporlar</h2>
            <div class="tanim-form ap-form">
                <div class="form-group">
                    <label class="control-label" for="ddlRaporlar">Rapor</label>
                    <div>
                        <select id="ddlRaporlar" class="form-control input-sm">
                            <option value="Liste">Ek 2</option>
                            <option value="Liste2">Ek 2 Detay</option>
                            <option value="OzetA">Özet Dök-1A</option>
                            <option value="OzetB">Özet Dök-1B</option>
                            <option value="Kiyas">Icmal-Detay</option>
                            <option value="Liste3">Ek 2 Tertip</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <span class="control-label"></span>
                    <div class="ap-satir">
                        <label class="checkbox-inline ap-onay"><input type="checkbox" id="chkImzaFormat" /> Çıktıda İmzalar Olsun</label>
                        <button type="button" id="btnImza" class="btn btn-default btn-xs" title="Raporlardaki imza bilgileri">
                            <span class="glyphicon glyphicon-pencil" aria-hidden="true"></span> İmzalar
                        </button>
                    </div>
                </div>
                <div class="ap-tuslar">
                    <button type="button" id="btnRapor" class="btn btn-default btn-sm">
                        <span class="glyphicon glyphicon-print" aria-hidden="true"></span> Rapor Hazırla
                    </button>
                </div>
            </div>
        </div>

        <div class="kutu bolum bolum-dosya">
            <h2 class="bolum-baslik">Dosya İşlem</h2>
            <p class="ap-ipucu">
                <span class="glyphicon glyphicon-info-sign" aria-hidden="true"></span>
                Her iki yükleme işlemi için de, 1. satırdan başlayarak ilk kolona tertip kodu, sonraki 12 kolona ay değerlerini giriniz!
            </p>
            <input type="file" id="fuListe" accept=".xls,.xlsx" hidden />
            <div class="ap-tuslar">
                <button type="button" id="btnDosyaYukle" class="btn btn-default btn-sm" title="Excel'deki tertipleri ve ay değerlerini tabloya getirir (kaydetmez)">
                    <span class="glyphicon glyphicon-upload" aria-hidden="true"></span> Yükle
                </button>
                <button type="button" id="btnEko2" class="btn btn-default btn-sm" title="2. düzey ekonomik kodlu dosyayı bir önceki aşamanın dağılımına göre alt tertiplere dağıtıp kaydeder">
                    <span class="glyphicon glyphicon-import" aria-hidden="true"></span> Eko 2 @program
                </button>
            </div>
        </div>
    </div>

    <!-- Sağ: aylık dağılım tablosu -->
    <div class="ap-sag kutu bolum bolum-tablo">
        <h2 class="bolum-baslik">@(Model.Gelir ? "Ayrıntılı Gelir Programı" : "Ayrıntılı Harcama Programı")</h2>
        <div class="btn-toolbar ap-arac" role="toolbar" aria-label="İşlemler">
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" id="btnOku" class="btn btn-primary">
                    <span class="glyphicon glyphicon-search" aria-hidden="true"></span> Listele
                </button>
                <div class="btn-group btn-group-sm ap-menu" role="group">
                    <button type="button" id="btnMenu" class="btn btn-default dropdown-toggle" aria-haspopup="true" aria-expanded="false">
                        <span class="glyphicon glyphicon-download-alt" aria-hidden="true"></span> İndir <span class="caret"></span>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="btnMenu">
                        <li><a href="#" data-islem="indir" data-sade="0">İndir</a></li>
                        <li><a href="#" data-islem="indir" data-sade="1">İndir (Sade)</a></li>
                        @if (!Model.Gelir)
                        {
                            <li role="separator" class="divider"></li>
                            <li><a href="#" data-islem="prgindir" data-seviye="4">Raporla AHP (Faal)</a></li>
                            <li><a href="#" data-islem="prgindir" data-seviye="5">Raporla AHP (Alt Faal)</a></li>
                            <li role="separator" class="divider yonetici" hidden></li>
                            <li class="yonetici" hidden><a href="#" data-islem="prggonder" data-seviye="4">SBB'ye Gönder (Faal)</a></li>
                            <li class="yonetici" hidden><a href="#" data-islem="prggonder" data-seviye="5">SBB'ye Gönder (Alt Faal)</a></li>
                            <li class="yonetici" hidden><a href="#" data-islem="prgal">SBB'den Al (Alt Faal)</a></li>
                        }
                    </ul>
                </div>
            </div>
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" id="btnKaydet" class="btn btn-success">
                    <span class="glyphicon glyphicon-floppy-disk" aria-hidden="true"></span> Kaydet
                </button>
                <button type="button" id="btnOnay" class="btn btn-default">
                    <span class="glyphicon glyphicon-ok" aria-hidden="true"></span> Onayla
                </button>
                <button type="button" id="btnOnayKaldir" class="btn btn-default">
                    <span class="glyphicon glyphicon-remove-circle" aria-hidden="true"></span> Onay Kaldır
                </button>
            </div>
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" id="btnOranUygula" class="btn btn-default"
                        title="Ekrandaki tablonun birinci satırındaki alana, aylık ödenekler yerine, oran giriniz ve bu tuşa basınız. Yazılım kbö'leri girdiğiniz orana göre dağıtarak, ekranda görünen tertipler için AHP üretilir. İşlemden sonra kaydet tuşuna basmanız gerekir.">
                    <span class="glyphicon glyphicon-scale" aria-hidden="true"></span> Oran Uygula
                </button>
                <button type="button" id="btnOranGetir" class="btn btn-default" title="Bir önceki yılın oranlarını birinci satıra getirir.">
                    <span class="glyphicon glyphicon-backward" aria-hidden="true"></span> Önc. Yıl Oran
                </button>
            </div>
            <label class="checkbox-inline ap-onay"><input type="checkbox" id="chkYuzde" checked /> Yüzdeler</label>
            <label class="checkbox-inline ap-onay"><input type="checkbox" id="chkToplam" checked /> Toplamlar</label>
            <div class="ap-kilit yonetici" hidden>
                <label for="spnKilitliAy">Kilitli ay</label>
                <input type="number" id="spnKilitliAy" class="form-control input-sm" min="0" max="12" step="1" value="0" />
                <button type="button" id="btnAyKilitle" class="btn btn-default btn-sm" title="Bu aya kadar olan aylar veri girişine kapatılır">
                    <span class="glyphicon glyphicon-lock" aria-hidden="true"></span><span class="sr-only">Ayları kilitle</span>
                </button>
            </div>
            <ul class="renk-aciklama" aria-label="Renkler">
                <li class="acik">Girilebilir</li>
                <li class="hesap">Hesaplanan</li>
                <li class="kilitli">Kilitli ay</li>
            </ul>
        </div>
        <div id="grdGrid" class="ap-grid" aria-label="Aylık dağılım"></div>
    </div>
</div>

<!-- Kod ağacı penceresi -->
<dialog id="dlgKod" class="tanim-pencere ap-agac" aria-labelledby="dlgKodBaslik">
    <div class="pencere-baslik">
        <h2 id="dlgKodBaslik">Kod Seçimi</h2>
        <button type="button" class="close" data-kapat aria-label="Kapat"><span aria-hidden="true">&times;</span></button>
    </div>
    <div class="pencere-govde" id="agacKutu"></div>
    <div class="pencere-alt">
        <button type="button" class="btn btn-default btn-sm" data-kapat>Kapat</button>
    </div>
</dialog>

<!-- İmzalar (eski ButceHazirlikv2/MasrafPlaniGenelImza.aspx) -->
<dialog id="dlgImza" class="tanim-pencere ap-imza" aria-labelledby="dlgImzaBaslik">
    <div class="pencere-baslik">
        <h2 id="dlgImzaBaslik">Rapor İmzaları</h2>
        <button type="button" class="close" data-kapat aria-label="Kapat"><span aria-hidden="true">&times;</span></button>
    </div>
    <form id="frmImza" class="pencere-govde tanim-form ap-form" novalidate>
        <div class="form-group">
            <label class="control-label" for="txtHazKisi">Hazırlayan Kişi</label>
            <div><input type="text" id="txtHazKisi" class="form-control input-sm" maxlength="200" /></div>
        </div>
        <div class="form-group">
            <label class="control-label" for="txtHazGorev">Hazırlayan Görev</label>
            <div><input type="text" id="txtHazGorev" class="form-control input-sm" maxlength="200" /></div>
        </div>
        <div class="form-group">
            <label class="control-label" for="txtImzKisi">İmzalayan Kişi</label>
            <div><input type="text" id="txtImzKisi" class="form-control input-sm" maxlength="200" /></div>
        </div>
        <div class="form-group">
            <label class="control-label" for="txtImzGorev">İmzalayan Görev</label>
            <div><input type="text" id="txtImzGorev" class="form-control input-sm" maxlength="200" /></div>
        </div>
    </form>
    <div class="pencere-alt">
        <button type="button" class="btn btn-default btn-sm" data-kapat>Kapat</button>
        <button type="button" id="btnImzaKaydet" class="btn btn-success btn-sm">
            <span class="glyphicon glyphicon-floppy-disk" aria-hidden="true"></span> Kaydet
        </button>
    </div>
</dialog>

@section Baslik {
    <link rel="stylesheet" href="~/css/tanim.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/apgiris.css" asp-append-version="true" />
}
@section Betikler {
    <script src="~/lib/ag-grid/ag-grid-community.min.js"></script>
    <script src="~/js/apgiris.js" asp-append-version="true"></script>
}
