@page
@model GirisModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="@Dil.Aktif">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="istek-jetonu" content="@Model.IstekJetonu" />
    <title>@Model.YazilimAd</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/giris.css" asp-append-version="true" />
</head>
<body class="giris" style="@(Model.ArkaPlan != null ? "background-image:url('" + Model.ArkaPlan + "')" : null)">
    <div class="giris-perde"></div>

    <main class="giris-kutu">
        <header class="giris-baslik">
            @if (Model.Logo != null)
            {
                <img src="@Model.Logo" alt="" class="giris-logo" />
            }
            @if (!string.IsNullOrEmpty(Model.KurumAdi))
            {
                <div class="giris-kurum">@Model.KurumAdi</div>
            }
            <h1>@Model.YazilimAd</h1>
        </header>

        @if (!string.IsNullOrEmpty(Model.SistemUyarisi))
        {
            <div class="alert alert-warning" role="alert">@Html.Raw(Model.SistemUyarisi)</div>
        }

        <div id="hata" class="alert alert-danger" role="alert" hidden></div>
        <div id="bilgi" class="alert alert-info" role="status" hidden></div>

        <!-- Aynı IP adresinden hatalı deneme sınırı aşılınca (eski GuvenlikResmi): her iki adımda da istenir -->
        <div id="guvenlik" class="form-group giris-guvenlik" hidden="@(!Model.GuvenlikKoduGerekli)">
            <label for="txtGuvenlik">@Metin.Menu("Giris_GuvenlikKodu")</label>
            <div class="giris-guvenlik-satir">
                <input type="text" id="txtGuvenlik" class="form-control input-lg" autocomplete="off" maxlength="10" />
                <img id="imgGuvenlik" alt="@Metin.Menu("Giris_GuvenlikKodu")" width="120" height="38" />
                <button type="button" id="btnGuvenlikYenile" class="btn btn-default" title="@Metin.Menu("Giris_GuvenlikYenile")">&#x21bb;</button>
            </div>
        </div>

        <!-- 1. adım: kullanıcı kodu ve parola -->
        <form id="frmParola" autocomplete="on" novalidate>
            <div class="form-group">
                <label for="txtKullanici">@Metin.Menu("Giris_KullaniciKodu")</label>
                <input type="text" id="txtKullanici" class="form-control input-lg" autocomplete="username"
                       maxlength="50" value="@Model.HatirlananKullanici" required />
            </div>
            <div class="form-group">
                <label for="txtParola">@Metin.Menu("Giris_Parola")</label>
                <input type="password" id="txtParola" class="form-control input-lg" autocomplete="current-password" required />
                <span id="buyukHarf" class="help-block" hidden>@Metin.Menu("Giris_BuyukHarf")</span>
            </div>
            <div class="checkbox">
                <label>
                    <input type="checkbox" id="chkHatirla" checked="@(!string.IsNullOrEmpty(Model.HatirlananKullanici))" />
                    @Metin.Menu("Giris_Hatirla")
                </label>
            </div>
            <button type="submit" id="btnGiris" class="btn btn-primary btn-lg btn-block">@Metin.Menu("Giris_Giris")</button>
            @if (Model.SifremiUnuttum)
            {
                <div class="giris-unuttum">
                    <a href="OrtakSayfa/SifremiUnuttum">@Metin.Menu("Giris_SifremiUnuttum")</a>
                </div>
            }
        </form>

        <!-- 2. adım: doğrulama kodu -->
        <form id="frmKod" autocomplete="off" novalidate hidden>
            <div class="form-group">
                <label for="txtKod">@Metin.Menu("Giris_DogrulamaKodu")</label>
                <input type="text" id="txtKod" class="form-control input-lg giris-kod" inputmode="numeric"
                       autocomplete="one-time-code" maxlength="6" required />
            </div>
            <button type="submit" id="btnKod" class="btn btn-primary btn-lg btn-block">@Metin.Menu("Giris_Dogrula")</button>
            <div class="giris-alt-islem">
                <button type="button" id="btnKodYenile" class="btn btn-link">@Metin.Menu("Giris_YeniKod")</button>
                <button type="button" id="btnGeri" class="btn btn-link">@Metin.Menu("Giris_Geri")</button>
            </div>
        </form>

        <footer class="giris-alt">
            @if (Model.Diller.Count > 1)
            {
                <nav class="giris-diller" aria-label="@Metin.Menu("Dil")">
                    @foreach (var d in Model.Diller)
                    {
                        if (d.Secili)
                        {
                            <span class="giris-dil secili" lang="@d.Kod">@d.Ad</span>
                        }
                        else
                        {
                            <a class="giris-dil" lang="@d.Kod" href="@d.Adres">@d.Ad</a>
                        }
                    }
                </nav>
            }
            <div class="giris-surum">@Metin.Menu("Surum") @Model.Surum</div>
        </footer>
    </main>

    <script type="application/json" id="metinler">@Json.Serialize(Model.Metinler)</script>
    <script src="~/js/giris.js" asp-append-version="true"></script>
</body>
</html>
